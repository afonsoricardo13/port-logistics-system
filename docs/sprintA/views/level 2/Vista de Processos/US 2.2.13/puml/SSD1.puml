@startuml Vista de Processos – Level 2 (US 2.2.13 – Register Qualification)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
    ArrowColor Black
  ActorBorderColor #000000
  ActorBackgroundColor #87CEEB
    LifeLineBorderColor Black
    LifeLineBackgroundColor #87CEEB
    ParticipantBorderColor Black
    ParticipantBackgroundColor #87CEEB
    ParticipantFontStyle bold
}

actor "Logistics Operator" as PA
participant "<<container (C4)>>\nVisualization (UI)" as UI #87CEEB
participant "<<container (C4)>>\nQualifications API" as PR #87CEEB

activate PA
PA -> UI: 1: register qualification
activate UI
UI --> PA: 1.1: ask for qualification data (code, name)
deactivate UI
PA -> UI: 2: qualification data
activate UI
UI --> PR: 2.1: request to register qualification
activate PR
PR -> UI: 2.2: qualification registered
deactivate PR
UI --> PA: 2.3: qualification registered
deactivate UI
deactivate PA

@enduml
