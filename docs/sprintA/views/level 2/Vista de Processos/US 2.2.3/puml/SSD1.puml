@startuml Vista de Processos – Level 2 (US 2.2.3 – Register Dock)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
	ArrowColor Black
  ActorBorderColor #000000
  ActorBackgroundColor #87CEEB
	LifeLineBorderColor Black
	LifeLineBackgroundColor #87CEEB
	ParticipantBorderColor Black
	ParticipantBackgroundColor #87CEEB
	ParticipantFontStyle bold
}

actor "Port Authority Officer" as PA
participant "<<container (C4)>>\nVisualization (UI)" as UI #87CEEB
participant "<<container (C4)>>\nDocks & Resources" as RES #87CEEB

activate PA
PA -> UI: 1: register dock
activate UI
UI --> PA: 1.1: ask for dock data
deactivate UI
PA -> UI: 2: dock data
activate UI
UI --> RES: 2.1: request to register dock
activate RES
RES -> UI: 2.2: dock registered
deactivate RES
UI --> PA: 2.3: dock registered
deactivate UI
deactivate PA

@enduml
