@startuml SSD US 2.2.7 - Approve Vessel Visit Notification
skinparam shadowing true
skinparam ArrowColor #000000
skinparam sequence {
    ArrowColor Black
    ActorBorderColor #000000
    ActorBackgroundColor #87CEEB
    LifeLineBorderColor Black
    LifeLineBackgroundColor #87CEEB
    ParticipantBorderColor Black
    ParticipantBackgroundColor #87CEEB
    ParticipantFontStyle bold
}

actor "Port Authority Officer" as Officer
participant "«system (C4)»\nPort Operations System" as System

activate Officer
Officer -> System : 1: select notification to approve
activate System
System --> Officer : 1.1: show notification details
deactivate System

Officer -> System : 2: approve notification
activate System
System --> Officer : 2.1: request dock assignment\n(select compatible dock)
deactivate System

Officer -> System : 3: assign dock and confirm
activate System
System --> Officer : 3.1: notification approved successfully\n(dock assigned, agent notified)
deactivate System
deactivate Officer

@enduml
