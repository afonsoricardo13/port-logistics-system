@startuml SSD US 2.2.3 - Register Docks
skinparam shadowing true
skinparam ArrowColor #000000
skinparam sequence {
	ArrowColor Black
  ActorBorderColor #000000
  ActorBackgroundColor #87CEEB
	LifeLineBorderColor Black
	LifeLineBackgroundColor #87CEEB
	ParticipantBorderColor Black
	ParticipantBackgroundColor #87CEEB
	ParticipantFontStyle bold
}

actor "Port Authority Officer" as Officer
participant "«system (C4)»\nPort Operations System" as System

activate Officer
Officer -> System : 1: starts dock creation
activate System
System  --> Officer : 1.1: request dock data\n(id, name/number, location,\nlength, depth, max draft,\nallowed vessel types)
deactivate System

Officer -> System : 2: provide requested data
activate System
System  --> Officer : 2.1: dock created successfully
deactivate System
deactivate Officer


@enduml
