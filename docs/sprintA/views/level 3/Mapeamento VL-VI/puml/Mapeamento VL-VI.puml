@startuml Mapping Logical ↔ Implementation – Level 3 (Port Operations System) — with internal links on both sides
left to right direction
skinparam shadowing true
skinparam linetype ortho
skinparam defaultTextAlignment center

skinparam rectangle {
  BackgroundColor #87CEEB
  BorderColor #000000
  RoundCorner 5
}
skinparam component {
  BackgroundColor #87CEEB
  BorderColor #000000
  RoundCorner 5
}
skinparam componentFontStyle bold
skinparam componentFontColor #000000

' ================= LEFT: Logical View (Level 3 / Onion) =================
rectangle "Logical View (Level 3 / Onion)" as LOG {

  ' ---- MDR: Docks & Resources (logical) ----
  rectangle "Docks & Resources (logical)" as DR_L {

    rectangle "Frameworks & Drivers" as DR_L_FD {
      component "Routing"                as DR_L_ROUT
      component "Persistence"            as DR_L_PERS
      component "Data Model"             as DR_L_DMODEL
      component "Filesystem / DB Driver" as DR_L_FSDRV
    }

    rectangle "Interface Adapters" as DR_L_ADP {
      component "Controller"            as DR_L_CTRL
      component "Repository"            as DR_L_REPO
      component "DTO"                   as DR_L_DTO
      component "External Repository"   as DR_L_EXTREPO
    }

    rectangle "Application Business Rules" as DR_L_APP {
      component "Application Service" as DR_L_APPSVC
    }

    rectangle "Enterprise Business Rules" as DR_L_DOM {
      component "Domain Model (DDD)" as DR_L_DOMAIN
    }

    ' ---- logical internal links (MDR) ----
    DR_L_ROUT  --> DR_L_CTRL
    DR_L_CTRL  --> DR_L_DTO
    DR_L_CTRL  --> DR_L_APPSVC
    DR_L_APPSVC --> DR_L_DOMAIN
    DR_L_APPSVC --> DR_L_REPO
    DR_L_REPO  --> DR_L_PERS
    DR_L_REPO  --> DR_L_DMODEL
    DR_L_FSDRV --> DR_L_PERS
  }

  ' ---- MDV: Visits & Manifests (logical) ----
  rectangle "Visits & Manifests (logical)" as VM_L {
    component "Routing"        as VM_L_ROUT
    component "Persistence"    as VM_L_PERS
    component "Controller"     as VM_L_CTRL
    component "Repository"     as VM_L_REPO
    component "Service"        as VM_L_SVC
    component "Domain Model"   as VM_L_DOMAIN

    ' ---- logical internal links (MDV) ----
    VM_L_ROUT --> VM_L_CTRL
    VM_L_CTRL --> VM_L_SVC
    VM_L_SVC  --> VM_L_REPO
    VM_L_SVC  --> VM_L_DOMAIN
    VM_L_REPO --> VM_L_PERS
  }

  ' ---- Planning & Scheduling (logical) ----
  rectangle "Planning & Scheduling (logical)" as PL_L {
    component "Routing"        as PL_L_ROUT
    component "Controller"     as PL_L_CTRL
    component "Repositories (clients/adapters)" as PL_L_REPO
    component "Application Service" as PL_L_SVC
    component "Domain Model (DDD)"  as PL_L_DOMAIN

    ' ---- logical internal links (Planning) ----
    PL_L_ROUT --> PL_L_CTRL
    PL_L_CTRL --> PL_L_SVC
    PL_L_SVC  --> PL_L_REPO
    PL_L_SVC  --> PL_L_DOMAIN
  }
}

' ================= RIGHT: Implementation View (Level 3) =================
rectangle "Implementation View (Level 3)" as IMP {

  ' ---- MDR: Docks & Resources (implementation) ----
  rectangle "Docks & Resources — Implementation" as DR_I {
    rectangle "Infrastructure" as DR_I_INF {
      component "Routes"      as DR_I_ROUTES
      component "Persistence" as DR_I_PERS
    }
    rectangle "Interface Adapters" as DR_I_ADP {
      component "IControllers"    as DR_I_ICTRL
      component "ImplControllers" as DR_I_CTRL
      component "Repositories"    as DR_I_REPO
    }
    rectangle "Application Services / Use Case Services" as DR_I_APP {
      component "IAppServices"     as DR_I_IAPP
      component "ImplAppServices"  as DR_I_APPSVC
      component "IRepositories"    as DR_I_IREPO
    }
    rectangle "Entities / Core / Domain" as DR_I_DOM {
      component "Aggregates"    as DR_I_AGG
      component "Value Objects" as DR_I_VO
      component "Services"      as DR_I_SVC
    }

    ' ---- internal impl links (MDR) ----
    DR_I_ROUTES ..down..> DR_I_ICTRL
    DR_I_PERS   ..up..>   DR_I_REPO
    DR_I_CTRL   ..down..> DR_I_IAPP
    DR_I_CTRL   ..down..> DR_I_APPSVC
    DR_I_ICTRL  <..       DR_I_CTRL
    DR_I_APPSVC ..right..> DR_I_IREPO
    DR_I_IAPP   <..       DR_I_APPSVC
    DR_I_APPSVC ..down..> DR_I_AGG
    DR_I_APPSVC ..down..> DR_I_VO
    DR_I_APPSVC ..down..> DR_I_SVC
    DR_I_IREPO  <..       DR_I_REPO
  }

  ' ---- MDV: Visits & Manifests (implementation) ----
  rectangle "Visits & Manifests — Implementation" as VM_I {
    rectangle "Infrastructure" as VM_I_INF {
      component "Routes"      as VM_I_ROUTES
      component "Persistence" as VM_I_PERS
    }
    rectangle "Interface Adapters" as VM_I_ADP {
      component "IControllers"    as VM_I_ICTRL
      component "ImplControllers" as VM_I_CTRL
      component "Repositories"    as VM_I_REPO
    }
    rectangle "Application Services / Use Case Services" as VM_I_APP {
      component "IAppServices"     as VM_I_IAPP
      component "ImplAppServices"  as VM_I_APPSVC
      component "IRepositories"    as VM_I_IREPO
    }
    rectangle "Entities / Core / Domain" as VM_I_DOM {
      component "Aggregates"    as VM_I_AGG
      component "Value Objects" as VM_I_VO
      component "Services"      as VM_I_SVC
    }

    VM_I_ROUTES ..down..> VM_I_ICTRL
    VM_I_PERS   ..up..>   VM_I_REPO
    VM_I_CTRL   ..down..> VM_I_IAPP
    VM_I_CTRL   ..down..> VM_I_APPSVC
    VM_I_ICTRL  <..       VM_I_CTRL
    VM_I_APPSVC ..right..> VM_I_IREPO
    VM_I_IAPP   <..       VM_I_APPSVC
    VM_I_APPSVC ..down..> VM_I_AGG
    VM_I_APPSVC ..down..> VM_I_VO
    VM_I_APPSVC ..down..> VM_I_SVC
    VM_I_IREPO  <..       VM_I_REPO
  }

  ' ---- Planning & Scheduling (implementation) ----
  rectangle "Planning & Scheduling — Implementation" as PL_I {
    rectangle "Infrastructure" as PL_I_INF {
      component "Routes"      as PL_I_ROUTES
    }
    rectangle "Interface Adapters" as PL_I_ADP {
      component "IControllers"    as PL_I_ICTRL
      component "ImplControllers" as PL_I_CTRL
      component "Repositories (Clients/Adapters)" as PL_I_REPO
    }
    rectangle "Application Services / Use Case Services" as PL_I_APP {
      component "IAppServices"     as PL_I_IAPP
      component "ImplAppServices"  as PL_I_APPSVC
      component "IRepositories"    as PL_I_IREPO
    }
    rectangle "Entities / Core / Domain" as PL_I_DOM {
      component "Aggregates"    as PL_I_AGG
      component "Value Objects" as PL_I_VO
      component "Services"      as PL_I_SVC
    }

    PL_I_ROUTES ..down..> PL_I_ICTRL
    PL_I_CTRL   ..down..> PL_I_IAPP
    PL_I_CTRL   ..down..> PL_I_APPSVC
    PL_I_ICTRL  <..       PL_I_CTRL
    PL_I_APPSVC ..right..> PL_I_IREPO
    PL_I_IREPO  <..       PL_I_REPO
    PL_I_IAPP   <..       PL_I_APPSVC
    PL_I_APPSVC ..down..> PL_I_AGG
    PL_I_APPSVC ..down..> PL_I_VO
    PL_I_APPSVC ..down..> PL_I_SVC
  }

  DR_I -[hidden]-> VM_I
  VM_I -[hidden]-> PL_I
}

' ======================= MAPPINGS Logical → Implementation ========================
' ---- MDR mappings ----
DR_L_ROUT   ..> DR_I_ROUTES : maps to
DR_L_PERS   ..> DR_I_PERS   : maps to
DR_L_DMODEL ..> DR_I_AGG    : maps to
DR_L_DMODEL ..> DR_I_VO     : maps to
DR_L_FSDRV  ..> DR_I_PERS   : implemented by
DR_L_CTRL   ..> DR_I_CTRL   : realized by
DR_L_REPO   ..> DR_I_REPO   : realized by
DR_L_EXTREPO ..> DR_I_IREPO : consumed via
DR_L_DTO    ..> DR_I_APPSVC : transformed by
DR_L_APPSVC ..> DR_I_APPSVC : realized by
DR_L_DOMAIN ..> DR_I_AGG    : realized by
DR_L_DOMAIN ..> DR_I_VO     : realized by
DR_L_DOMAIN ..> DR_I_SVC    : realized by

' ---- MDV mappings ----
VM_L_ROUT   ..> VM_I_ROUTES : maps to
VM_L_PERS   ..> VM_I_PERS   : maps to
VM_L_CTRL   ..> VM_I_CTRL   : realized by
VM_L_REPO   ..> VM_I_REPO   : realized by
VM_L_SVC    ..> VM_I_APPSVC : realized by
VM_L_DOMAIN ..> VM_I_AGG    : realized by
VM_L_DOMAIN ..> VM_I_VO     : realized by
VM_L_DOMAIN ..> VM_I_SVC    : realized by

' ---- Planning mappings ----
PL_L_ROUT   ..> PL_I_ROUTES : maps to
PL_L_CTRL   ..> PL_I_CTRL   : realized by
PL_L_REPO   ..> PL_I_REPO   : realized by
PL_L_SVC    ..> PL_I_APPSVC : realized by
PL_L_DOMAIN ..> PL_I_AGG    : realized by
PL_L_DOMAIN ..> PL_I_VO     : realized by
PL_L_DOMAIN ..> PL_I_SVC    : realized by

@enduml
