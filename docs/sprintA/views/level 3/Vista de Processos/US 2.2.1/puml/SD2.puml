@startuml Vista de Processos – Level 3 (US 2.2.1 – Update Vessel Type)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
	ArrowColor Black
	ActorBorderColor #000000
	ActorBackgroundColor #87CEEB
	LifeLineBorderColor Black
	LifeLineBackgroundColor #87CEEB
	ParticipantBorderColor Black
	ParticipantBackgroundColor #87CEEB
	ParticipantFontStyle bold
}

actor "Port Authority Officer" as Officer
participant "«container (C4)»\nVisualization (UI)" as UI_CTRL #87CEEB
participant "«container (C4)»\nVisits & Manifests\nController" as TYPES_CTRL #87CEEB
participant "«component»\nApplication Service" as TYPES_APP #87CEEB
participant "«component»\nDomain Model (VesselType)" as TYPES_DOMAIN #87CEEB
participant "«component»\nRepository" as TYPES_REPO #87CEEB
participant "«component»\nData Model" as TYPES_DATA #87CEEB
participant "«component»\nPersistence" as TYPES_PERSIST #87CEEB

activate Officer
Officer -> UI_CTRL: 1: search by name/description
activate UI_CTRL
UI_CTRL -> TYPES_CTRL: 1.1: getTypesByFilter(name?, description?)
activate TYPES_CTRL
TYPES_CTRL -> TYPES_APP: 1.1.1: searchTypes(filter)
activate TYPES_APP
TYPES_APP -> TYPES_REPO: 1.1.1.1: query(filter)
activate TYPES_REPO
TYPES_REPO -> TYPES_PERSIST: 1.1.1.1.1: SELECT ... WHERE name LIKE ... OR description LIKE ...
activate TYPES_PERSIST
TYPES_PERSIST --> TYPES_REPO: 1.1.1.1.2: result list
deactivate TYPES_PERSIST
TYPES_REPO --> TYPES_APP: 1.1.1.1.3: entities
deactivate TYPES_REPO
TYPES_APP --> TYPES_CTRL: 1.1.2: results (DTOs)
deactivate TYPES_APP
TYPES_CTRL --> UI_CTRL: 1.2: list for selection
deactivate TYPES_CTRL
UI_CTRL --> Officer: 1.3: show results

Officer -> UI_CTRL: 2: select type and submit changes (DTO)
activate UI_CTRL
UI_CTRL -> TYPES_CTRL: 2.1: updateType(id, dto)
activate TYPES_CTRL
TYPES_CTRL -> TYPES_APP: 2.1.1: updateType(id, dto)
activate TYPES_APP
TYPES_APP -> TYPES_REPO: 2.1.1.1: getById(id)
activate TYPES_REPO
TYPES_REPO -> TYPES_PERSIST: 2.1.1.1.1: SELECT by id
activate TYPES_PERSIST
TYPES_PERSIST --> TYPES_REPO: 2.1.1.1.2: entity
deactivate TYPES_PERSIST
TYPES_REPO --> TYPES_APP: 2.1.1.1.3: entity
deactivate TYPES_REPO
TYPES_APP -> TYPES_DOMAIN: 2.1.1.2: apply changes (name, description, capacity, constraints)
activate TYPES_DOMAIN
TYPES_DOMAIN --> TYPES_APP: 2.1.1.3: updated entity
deactivate TYPES_DOMAIN
TYPES_APP -> TYPES_APP: 2.1.1.4: validate new values (capacity/constraints)
TYPES_APP -> TYPES_REPO: 2.1.1.5: update(entity)
activate TYPES_REPO
TYPES_REPO -> TYPES_DATA: 2.1.1.5.1: map to data model
activate TYPES_DATA
TYPES_DATA --> TYPES_REPO: 2.1.1.5.2: data record
deactivate TYPES_DATA
TYPES_REPO -> TYPES_PERSIST: 2.1.1.5.3: UPDATE VesselType SET ... WHERE id = ...
activate TYPES_PERSIST
TYPES_PERSIST --> TYPES_REPO: 2.1.1.5.4: ok
deactivate TYPES_PERSIST
TYPES_REPO --> TYPES_APP: 2.1.1.6: updated(entity)
deactivate TYPES_REPO
TYPES_APP --> TYPES_CTRL: 2.1.2: updated DTO
deactivate TYPES_APP
TYPES_CTRL --> UI_CTRL: 2.2: update confirmation
deactivate TYPES_CTRL
UI_CTRL --> Officer: 2.3: show confirmation
deactivate UI_CTRL

deactivate Officer

@enduml