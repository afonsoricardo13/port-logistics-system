@startuml Vista de Processos – Level 3 (US 2.2.3 – Update Dock)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
	ArrowColor Black
	ActorBorderColor #000000
	ActorBackgroundColor #87CEEB
	LifeLineBorderColor Black
	LifeLineBackgroundColor #87CEEB
	ParticipantBorderColor Black
	ParticipantBackgroundColor #87CEEB
	ParticipantFontStyle bold
}

actor "Port Authority Officer" as PA
participant "«container (C4)»\nVisualization (UI)\nController" as UI_CTRL #87CEEB
participant "«container (C4)»\nDocks & Resources\nController" as MDR_CTRL #87CEEB
participant "«component»\nApplication Service" as MDR_APP #87CEEB
participant "«component»\nDomain Model (Dock)" as MDR_DOMAIN #87CEEB
participant "«component»\nRepository" as MDR_REPO #87CEEB
participant "«component»\nData Model" as MDR_DATA #87CEEB
participant "«component»\nPersistence" as MDR_PERSIST #87CEEB

activate PA
PA -> UI_CTRL: 1: update dock
activate UI_CTRL
UI_CTRL --> PA: 1.1: show current dock data
deactivate UI_CTRL
PA -> UI_CTRL: 2: dock data update (DockDTO)
activate UI_CTRL
UI_CTRL -> MDR_CTRL: 2.1: request to update dock (DockDTO)
activate MDR_CTRL
MDR_CTRL -> MDR_APP: 2.1.1: updateDock(dockId, DockDTO)
activate MDR_APP
MDR_APP -> MDR_REPO: 2.1.1.1: getById(dockId)
activate MDR_REPO
MDR_REPO -> MDR_PERSIST: 2.1.1.1.1: fetch(record)
activate MDR_PERSIST
MDR_PERSIST --> MDR_REPO: 2.1.1.1.2: record
deactivate MDR_PERSIST
MDR_REPO -> MDR_DATA: 2.1.1.1.3: map to domain
activate MDR_DATA
MDR_DATA --> MDR_REPO: 2.1.1.1.4: dock aggregate
deactivate MDR_DATA
MDR_REPO --> MDR_APP: 2.1.1.2: dock aggregate
deactivate MDR_REPO
MDR_APP -> MDR_DOMAIN: 2.1.1.3: validate & apply changes
activate MDR_DOMAIN
MDR_DOMAIN --> MDR_APP: 2.1.1.4: dock updated
deactivate MDR_DOMAIN
MDR_APP -> MDR_REPO: 2.1.1.5: save(updated dock)
activate MDR_REPO
MDR_REPO -> MDR_DATA: 2.1.1.5.1: map to data model
activate MDR_DATA
MDR_DATA --> MDR_REPO: 2.1.1.5.2: updated record
deactivate MDR_DATA
MDR_REPO -> MDR_PERSIST: 2.1.1.5.3: persist(updated record)
activate MDR_PERSIST
MDR_PERSIST --> MDR_REPO: 2.1.1.5.4: ok
deactivate MDR_PERSIST
MDR_REPO --> MDR_APP: 2.1.1.6: persisted(updated dock)
deactivate MDR_REPO
MDR_APP --> MDR_CTRL: 2.1.2: dock updated (DockDTO)
deactivate MDR_APP
MDR_CTRL --> UI_CTRL: 2.2: dock updated
deactivate MDR_CTRL
UI_CTRL --> PA: 2.3: dock updated
deactivate UI_CTRL
deactivate PA

@enduml
