@startuml Vista de Processos – Level 3 (US 2.2.11 – Register Operating Staff)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
	ArrowColor Black
	ActorBorderColor #000000
	ActorBackgroundColor #87CEEB
	LifeLineBorderColor Black
	LifeLineBackgroundColor #87CEEB
	ParticipantBorderColor Black
	ParticipantBackgroundColor #87CEEB
	ParticipantFontStyle bold
}

actor "Logistics Operator" as LO
participant "«container (C4)»\nVisualization (UI)" as UI_CTRL #87CEEB
participant "«container (C4)»\nDocks & Resources\nController" as MDR_CTRL #87CEEB
participant "«component»\nApplication Service" as MDR_APP #87CEEB
participant "«component»\nDomain Model (Staff)" as MDR_DOMAIN #87CEEB
participant "«component»\nRepository" as MDR_REPO #87CEEB
participant "«component»\nData Model" as MDR_DATA #87CEEB
participant "«component»\nPersistence" as MDR_PERSIST #87CEEB

activate LO
LO -> UI_CTRL: 1: register staff member
activate UI_CTRL
UI_CTRL --> LO: 1.1: ask for staff member data
deactivate UI_CTRL
LO -> UI_CTRL: 2: staff member data (StaffDTO)
activate UI_CTRL
UI_CTRL -> MDR_CTRL: 2.1: request to register staff member (StaffDTO)
activate MDR_CTRL
MDR_CTRL -> MDR_APP: 2.1.1: registerStaff(StaffDTO)
activate MDR_APP
MDR_APP -> MDR_DOMAIN: 2.1.1.1: create Staff aggregate
activate MDR_DOMAIN
MDR_DOMAIN --> MDR_APP: 2.1.1.2: staff aggregate
deactivate MDR_DOMAIN
MDR_APP -> MDR_REPO: 2.1.1.3: save(staff)
activate MDR_REPO
MDR_REPO -> MDR_DATA: 2.1.1.3.1: map to data model
activate MDR_DATA
MDR_DATA --> MDR_REPO: 2.1.1.3.2: staff record
deactivate MDR_DATA
MDR_REPO -> MDR_PERSIST: 2.1.1.3.3: persist(record)
activate MDR_PERSIST
MDR_PERSIST --> MDR_REPO: 2.1.1.3.4: ok
deactivate MDR_PERSIST
MDR_REPO --> MDR_APP: 2.1.1.4: persisted(staff)
deactivate MDR_REPO
MDR_APP --> MDR_CTRL: 2.1.2: staff created (StaffDTO)
deactivate MDR_APP
MDR_CTRL --> UI_CTRL: 2.2: staff member registered (StaffDTO)
deactivate MDR_CTRL
UI_CTRL --> LO: 2.3: staff member registered
deactivate UI_CTRL
deactivate LO

@enduml
