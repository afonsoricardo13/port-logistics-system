@startuml Vista de Processos – Level 3 (US 2.2.11 – Deactivate Operating Staff)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
	ArrowColor Black
	ActorBorderColor #000000
	ActorBackgroundColor #87CEEB
	LifeLineBorderColor Black
	LifeLineBackgroundColor #87CEEB
	ParticipantBorderColor Black
	ParticipantBackgroundColor #87CEEB
	ParticipantFontStyle bold
}

actor "Logistics Operator" as LO
participant "«container (C4)»\nVisualization (UI)" as UI_CTRL #87CEEB
participant "«container (C4)»\nDocks & Resources\nController" as MDR_CTRL #87CEEB
participant "«component»\nApplication Service" as MDR_APP #87CEEB
participant "«component»\nDomain Model (Staff)" as MDR_DOMAIN #87CEEB
participant "«component»\nRepository" as MDR_REPO #87CEEB
participant "«component»\nData Model" as MDR_DATA #87CEEB
participant "«component»\nPersistence" as MDR_PERSIST #87CEEB

activate LO
LO -> UI_CTRL: 1: deactivate staff member
activate UI_CTRL
UI_CTRL --> LO: 1.1: request confirmation
deactivate UI_CTRL
LO -> UI_CTRL: 2: confirm deactivation
activate UI_CTRL
UI_CTRL -> MDR_CTRL: 2.1: request to deactivate staff member
activate MDR_CTRL
MDR_CTRL -> MDR_APP: 2.1.1: deactivateStaff(staffId)
activate MDR_APP
MDR_APP -> MDR_REPO: 2.1.1.1: getById(staffId)
activate MDR_REPO
MDR_REPO -> MDR_PERSIST: 2.1.1.1.1: fetch(record)
activate MDR_PERSIST
MDR_PERSIST --> MDR_REPO: 2.1.1.1.2: record
deactivate MDR_PERSIST
MDR_REPO -> MDR_DATA: 2.1.1.1.3: map to domain
activate MDR_DATA
MDR_DATA --> MDR_REPO: 2.1.1.1.4: staff aggregate
deactivate MDR_DATA
MDR_REPO --> MDR_APP: 2.1.1.2: staff aggregate
deactivate MDR_REPO
MDR_APP -> MDR_DOMAIN: 2.1.1.3: apply deactivation
activate MDR_DOMAIN
MDR_DOMAIN --> MDR_APP: 2.1.1.4: staff deactivated
deactivate MDR_DOMAIN
MDR_APP -> MDR_REPO: 2.1.1.5: save(deactivated staff)
activate MDR_REPO
MDR_REPO -> MDR_DATA: 2.1.1.5.1: map to data model
activate MDR_DATA
MDR_DATA --> MDR_REPO: 2.1.1.5.2: updated record
deactivate MDR_DATA
MDR_REPO -> MDR_PERSIST: 2.1.1.5.3: persist(updated record)
activate MDR_PERSIST
MDR_PERSIST --> MDR_REPO: 2.1.1.5.4: ok
deactivate MDR_PERSIST
MDR_REPO --> MDR_APP: 2.1.1.6: persisted(deactivated staff)
deactivate MDR_REPO
MDR_APP --> MDR_CTRL: 2.1.2: staff deactivated
deactivate MDR_APP
MDR_CTRL --> UI_CTRL: 2.2: staff member deactivated
deactivate MDR_CTRL
UI_CTRL --> LO: 2.3: staff member deactivated
deactivate UI_CTRL
deactivate LO

@enduml
