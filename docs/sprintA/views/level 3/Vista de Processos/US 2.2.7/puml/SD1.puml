@startuml Vista de Processos – Level 3 (US 2.2.7 – Review Pending Vessel Visit Notifications)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
    ArrowColor Black
    ActorBorderColor #000000
    ActorBackgroundColor #87CEEB
    LifeLineBorderColor Black
    LifeLineBackgroundColor #87CEEB
    ParticipantBorderColor Black
    ParticipantBackgroundColor #87CEEB
    ParticipantFontStyle bold
}

actor "Port Authority Officer" as Officer
participant "«container (C4)»\nVisualization (UI)" as UI_CTRL #87CEEB
participant "«container (C4)»\nVisits & Manifests\nController" as VVN_CTRL #87CEEB
participant "«component»\nApplication Service" as VVN_APP #87CEEB
participant "«component»\nRepository" as VVN_REPO #87CEEB
participant "«component»\nData Model" as VVN_DATA #87CEEB
participant "«component»\nPersistence" as VVN_PERSIST #87CEEB

activate Officer
Officer -> UI_CTRL: 1: request pending notifications
activate UI_CTRL
UI_CTRL -> VVN_CTRL: 1.1: GET /api/vessel-visits/notifications?status=pending
activate VVN_CTRL
VVN_CTRL -> VVN_APP: 1.1.1: getPendingNotifications()
activate VVN_APP
VVN_APP -> VVN_REPO: 1.1.1.1: getByStatus(PENDING)
activate VVN_REPO
VVN_REPO -> VVN_PERSIST: 1.1.1.1.1: query(status = PENDING)
activate VVN_PERSIST
VVN_PERSIST --> VVN_REPO: 1.1.1.1.2: records
deactivate VVN_PERSIST
VVN_REPO -> VVN_DATA: 1.1.1.1.3: map to domain
activate VVN_DATA
VVN_DATA --> VVN_REPO: 1.1.1.1.4: VesselVisitNotification aggregates
deactivate VVN_DATA
VVN_REPO --> VVN_APP: 1.1.1.2: list of VesselVisitNotifications
deactivate VVN_REPO
VVN_APP --> VVN_CTRL: 1.1.2: list of VesselVisitNotificationDTOs
deactivate VVN_APP
VVN_CTRL --> UI_CTRL: 1.2: JSON response (pending notifications)
deactivate VVN_CTRL
UI_CTRL --> Officer: 1.3: display pending notifications list
deactivate UI_CTRL
deactivate Officer

@enduml
