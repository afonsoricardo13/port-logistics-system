@startuml Vista de Processos – Level 3 (US 2.2.7 – Approve Vessel Visit Notification)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
    ArrowColor Black
    ActorBorderColor #000000
    ActorBackgroundColor #87CEEB
    LifeLineBorderColor Black
    LifeLineBackgroundColor #87CEEB
    ParticipantBorderColor Black
    ParticipantBackgroundColor #87CEEB
    ParticipantFontStyle bold
}

actor "Port Authority Officer" as Officer
participant "«container (C4)»\nVisualization (UI)" as UI_CTRL #87CEEB
participant "«container (C4)»\nVisits & Manifests\nController" as VVN_CTRL #87CEEB
participant "«component»\nApplication Service" as VVN_APP #87CEEB
participant "«component»\nDomain Model\n(VesselVisitNotification)" as VVN_DOMAIN #87CEEB
participant "«component»\nDomain Model\n(DecisionLog)" as DL_DOMAIN #87CEEB
participant "«component»\nRepository" as VVN_REPO #87CEEB
participant "«component»\nDock Repository" as DOCK_REPO #87CEEB
participant "«component»\nData Model" as VVN_DATA #87CEEB
participant "«component»\nPersistence" as VVN_PERSIST #87CEEB

activate Officer
Officer -> UI_CTRL: 1: select notification to approve
activate UI_CTRL
UI_CTRL --> Officer: 1.1: show notification details
deactivate UI_CTRL

Officer -> UI_CTRL: 2: assign dock and approve
activate UI_CTRL
UI_CTRL -> VVN_CTRL: 2.1: POST /api/vessel-visits/notifications/{id}/approve\n(ApproveNotificationDTO: dockCode, notes, officerId)
activate VVN_CTRL
VVN_CTRL -> VVN_APP: 2.1.1: approveNotification(notificationId, dockCode, officerId, notes)
activate VVN_APP
VVN_APP -> DOCK_REPO: 2.1.1.1: existsByCode(dockCode)
activate DOCK_REPO
DOCK_REPO --> VVN_APP: 2.1.1.2: dock exists validation
deactivate DOCK_REPO
VVN_APP -> VVN_REPO: 2.1.1.3: getById(notificationId)
activate VVN_REPO
VVN_REPO -> VVN_PERSIST: 2.1.1.3.1: fetch(record)
activate VVN_PERSIST
VVN_PERSIST --> VVN_REPO: 2.1.1.3.2: record
deactivate VVN_PERSIST
VVN_REPO -> VVN_DATA: 2.1.1.3.3: map to domain
activate VVN_DATA
VVN_DATA --> VVN_REPO: 2.1.1.3.4: VesselVisitNotification aggregate
deactivate VVN_DATA
VVN_REPO --> VVN_APP: 2.1.1.4: notification aggregate
deactivate VVN_REPO
VVN_APP -> DL_DOMAIN: 2.1.1.5: create DecisionLog\n(officerId, APPROVED, dockCode, notes, timestamp)
activate DL_DOMAIN
DL_DOMAIN --> VVN_APP: 2.1.1.6: DecisionLog value object
deactivate DL_DOMAIN
VVN_APP -> VVN_DOMAIN: 2.1.1.7: approve(decisionLog)
activate VVN_DOMAIN
VVN_DOMAIN --> VVN_APP: 2.1.1.8: notification approved\n(status = APPROVED, dock assigned)
deactivate VVN_DOMAIN
VVN_APP -> VVN_REPO: 2.1.1.9: save(approved notification)
activate VVN_REPO
VVN_REPO -> VVN_DATA: 2.1.1.9.1: map to data model
activate VVN_DATA
VVN_DATA --> VVN_REPO: 2.1.1.9.2: updated record
deactivate VVN_DATA
VVN_REPO -> VVN_PERSIST: 2.1.1.9.3: persist(updated record)
activate VVN_PERSIST
VVN_PERSIST --> VVN_REPO: 2.1.1.9.4: ok
deactivate VVN_PERSIST
VVN_REPO --> VVN_APP: 2.1.1.10: persisted
deactivate VVN_REPO
VVN_APP --> VVN_CTRL: 2.1.2: approval confirmation (VesselVisitNotificationDTO)
deactivate VVN_APP
VVN_CTRL --> UI_CTRL: 2.2: HTTP 200 OK (notification approved)
deactivate VVN_CTRL
UI_CTRL --> Officer: 2.3: display approval confirmation
deactivate UI_CTRL
deactivate Officer

@enduml
