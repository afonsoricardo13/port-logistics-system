@startuml C4 Context (System Context Diagram for Port Logistics System)
' If includes fail in your renderer, download C4-PlantUML locally and switch these to local paths.
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_LEFT_RIGHT()

Person(portOfficer, "Port Authority Officer", "Approves/rejects Vessel Visit notifications, assigns docks, enforces operational compliance, and manages shipping agent registrations and vessel authorizations.")
Person(shipAgent, "Shipping Agent Representative", "Submits visit notifications and Cargo Manifests, updates/cancels notifications before approval, supplies documentation, and tracks approved visit status.")
Person(logOperator, "Logistics Operator", "Defines/schedules operations, allocates resources, monitors and adjusts execution, ensuring efficient cargo flow through docks, yards, and warehouses.")
Person(adminUser, "Administrator", "Manages accounts/permissions, configures system settings, and ensures data integrity.")

System_Boundary(pls, "Port Logistics System") {
  System(pls_sys, "Port Logistics System", "Web-based system for port logistics")
}

System_Ext(idp, "External Identity Provider (IAM)", "OIDC/OAuth2 (e.g., Microsoft/Google)")
System_Ext(email, "Email/Notifications", "Optional outbound notifications")

Rel(portOfficer, pls_sys, "Uses", "HTTPS")
Rel(shipAgent, pls_sys, "Uses", "HTTPS")
Rel(logOperator, pls_sys, "Uses", "HTTPS")
Rel(adminUser, pls_sys, "Uses", "HTTPS")
Rel_D(pls_sys, idp, "Authenticate users", "OIDC/OAuth2")
Rel_D(pls_sys, email, "Send notifications", "SMTP/Webhook (optional)")

SHOW_LEGEND()
@enduml

'Ver se Email/Notifications é necessário ou pode ser removido.