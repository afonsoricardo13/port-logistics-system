@startuml Vista de Processos Frontend – US 4.1.14 (Manage Complementary Task Categories - SPA)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
	ArrowColor Black
	ActorBorderColor #000000
	ActorBackgroundColor #87CEEB
	LifeLineBorderColor Black
	LifeLineBackgroundColor #87CEEB
	ParticipantBorderColor Black
	ParticipantBackgroundColor #87CEEB
	ParticipantFontStyle bold
}

actor "Port Operations Supervisor" as USER

box "SPA (Angular)" #LightBlue
    participant "ComplementaryTaskCategoriesComponent" as COMP
    participant "ComplementaryTaskCategoryService" as CTC_SVC
    participant "MatDialog" as DIALOG
    participant "AuthService" as AUTH
end box

participant "<<external>>\nIAM" as IAM #F5F5DC

USER -> COMP: 1: navigate to /complementary-task-categories
activate COMP

COMP -> AUTH: 1.1: getToken()
activate AUTH
AUTH -> IAM: 1.1.1: validate (Port Operations Supervisor role)
activate IAM
IAM --> AUTH: 1.1.2: authorized
deactivate IAM
AUTH --> COMP: 1.1.3: token
deactivate AUTH

COMP -> CTC_SVC: 1.2: getAll()
activate CTC_SVC
CTC_SVC --> COMP: 1.2.1: list of categories
deactivate CTC_SVC

COMP --> USER: 1.3: display categories table
deactivate COMP

USER -> COMP: 2: click "Add Category"
activate COMP

COMP -> DIALOG: 2.1: open(CreateCategoryDialogComponent)
activate DIALOG
DIALOG --> USER: 2.2: display create form
deactivate DIALOG
deactivate COMP

USER -> DIALOG: 3: fill form (code, name, description, duration, impact), click "Create"
activate DIALOG

DIALOG -> DIALOG: 3.1: validateForm()
note right
    Form fields:
    - Code (CTC###)
    - Name
    - Description
    - Default Duration (optional)
    - Expected Impact (optional)
end note

DIALOG -> CTC_SVC: 3.2: create(category)
activate CTC_SVC
CTC_SVC --> DIALOG: 3.2.1: created category
deactivate CTC_SVC

DIALOG --> COMP: 3.3: close(createdCategory)
deactivate DIALOG

activate COMP
COMP -> COMP: 3.4: refreshTable()
COMP --> USER: 3.5: display updated table
deactivate COMP

USER -> COMP: 4: click edit icon on a row
activate COMP

COMP -> DIALOG: 4.1: open(EditCategoryDialogComponent, {category})
activate DIALOG
DIALOG --> USER: 4.2: display edit form with current values
deactivate DIALOG
deactivate COMP

USER -> DIALOG: 5: modify fields, click "Update"
activate DIALOG

DIALOG -> CTC_SVC: 5.1: update(code, UpdateCategoryDTO)
activate CTC_SVC
CTC_SVC --> DIALOG: 5.1.1: updated category
deactivate CTC_SVC

DIALOG --> COMP: 5.2: close(updatedCategory)
deactivate DIALOG

activate COMP
COMP -> COMP: 5.3: updateRowInTable()
COMP --> USER: 5.4: display updated row
deactivate COMP

@enduml
