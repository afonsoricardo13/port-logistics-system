@startuml Vista de Processos Frontend – US 4.1.7 (Create VVE - SPA)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
	ArrowColor Black
	ActorBorderColor #000000
	ActorBackgroundColor #87CEEB
	LifeLineBorderColor Black
	LifeLineBackgroundColor #87CEEB
	ParticipantBorderColor Black
	ParticipantBackgroundColor #87CEEB
	ParticipantFontStyle bold
}

actor "Logistics Operator" as USER

box "SPA (Angular)" #LightBlue
    participant "VesselVisitExecutionsComponent" as COMP
    participant "VesselVisitExecutionService" as VVE_SVC
    participant "VesselVisitNotificationService" as VVN_SVC
    participant "AuthService" as AUTH
    participant "Router" as ROUTER
end box

participant "<<external>>\nIAM" as IAM #F5F5DC

USER -> COMP: 1: navigate to /vessel-visit-executions/create
activate COMP

COMP -> AUTH: 1.1: getToken()
activate AUTH
AUTH -> IAM: 1.1.1: validateSession()
activate IAM
IAM --> AUTH: 1.1.2: valid JWT + user info
deactivate IAM
AUTH --> COMP: 1.1.3: token, userEmail
deactivate AUTH

COMP -> VVN_SVC: 1.2: getApprovedVVNs()
activate VVN_SVC
VVN_SVC --> COMP: 1.2.1: list of approved VVNs without VVE
deactivate VVN_SVC

COMP --> USER: 1.3: display VVN selection dropdown + arrival time input
deactivate COMP

USER -> COMP: 2: select VVN, enter arrival time, click "Create VVE"
activate COMP

COMP -> COMP: 2.1: validateForm()
note right: Validate VVN selected and arrival time valid

COMP -> VVE_SVC: 2.2: create(CreateVveDTO)
activate VVE_SVC
VVE_SVC --> COMP: 2.2.1: created VVE (status: InProgress)
deactivate VVE_SVC

COMP -> COMP: 2.3: showSuccessToast("VVE created successfully")

COMP -> ROUTER: 2.4: navigate(['/vessel-visit-executions', vve.id])
activate ROUTER
ROUTER --> USER: 2.5: redirect to VVE details page
deactivate ROUTER
deactivate COMP

@enduml
