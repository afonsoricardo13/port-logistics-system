@startuml Vista de Processos Frontend – US 4.1.13 (Record Incidents - SPA)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
	ArrowColor Black
	ActorBorderColor #000000
	ActorBackgroundColor #87CEEB
	LifeLineBorderColor Black
	LifeLineBackgroundColor #87CEEB
	ParticipantBorderColor Black
	ParticipantBackgroundColor #87CEEB
	ParticipantFontStyle bold
}

actor "Logistics Operator" as USER

box "SPA (Angular)" #LightBlue
    participant "IncidentsComponent" as COMP
    participant "IncidentsService" as INC_SVC
    participant "IncidentTypeService" as IT_SVC
    participant "VesselVisitExecutionService" as VVE_SVC
    participant "MatDialog" as DIALOG
    participant "AuthService" as AUTH
end box

participant "<<external>>\nIAM" as IAM #F5F5DC

USER -> COMP: 1: navigate to /incidents
activate COMP

COMP -> AUTH: 1.1: getToken()
activate AUTH
AUTH --> COMP: 1.1.1: token, userEmail
deactivate AUTH

COMP -> INC_SVC: 1.2: getAll(filter)
activate INC_SVC
INC_SVC --> COMP: 1.2.1: list of incidents
deactivate INC_SVC

COMP --> USER: 1.3: display incidents table with active incidents highlighted
deactivate COMP

USER -> COMP: 2: click "Record New Incident"
activate COMP

COMP -> DIALOG: 2.1: open(CreateIncidentDialogComponent)
activate DIALOG

DIALOG -> IT_SVC: 2.1.1: getAll()
activate IT_SVC
IT_SVC --> DIALOG: 2.1.2: incident types for dropdown
deactivate IT_SVC

DIALOG -> VVE_SVC: 2.1.3: getByStatus(InProgress)
activate VVE_SVC
VVE_SVC --> DIALOG: 2.1.4: in-progress VVEs for selection
deactivate VVE_SVC

DIALOG --> USER: 2.2: display incident form
deactivate DIALOG
deactivate COMP

USER -> DIALOG: 3: fill form, select affected VVEs, click "Create"
activate DIALOG

DIALOG -> DIALOG: 3.1: validateForm()
note right
    Form fields:
    - Incident Type (dropdown)
    - Severity (Minor/Major/Critical)
    - Description (text)
    - Affected VVEs (multi-select or "All ongoing")
end note

DIALOG -> INC_SVC: 3.2: create(CreateIncidentDTO)
activate INC_SVC
INC_SVC --> DIALOG: 3.2.1: created incident with ID
deactivate INC_SVC

DIALOG --> COMP: 3.3: close(createdIncident)
deactivate DIALOG

activate COMP
COMP -> COMP: 3.4: refreshTable()
COMP -> COMP: 3.5: showSuccessNotification()
COMP --> USER: 3.6: display updated table with new incident
deactivate COMP

@enduml
