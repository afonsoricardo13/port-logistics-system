@startuml Vista de Processos Frontend – US 4.1.4 (View Plan Details - SPA)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
	ArrowColor Black
	ActorBorderColor #000000
	ActorBackgroundColor #87CEEB
	LifeLineBorderColor Black
	LifeLineBackgroundColor #87CEEB
	ParticipantBorderColor Black
	ParticipantBackgroundColor #87CEEB
	ParticipantFontStyle bold
}

actor "Logistics Operator" as USER

box "SPA (Angular)" #LightBlue
    participant "OperationPlanDetailsComponent" as COMP
    participant "OperationPlanService" as SVC
    participant "TimelineComponent" as TIMELINE
    participant "AuthService" as AUTH
end box

participant "<<external>>\nIAM" as IAM #F5F5DC

USER -> COMP: 1: navigate to /operation-plans/{planId}
activate COMP

COMP -> AUTH: 1.1: getToken()
activate AUTH
AUTH -> IAM: 1.1.1: validateSession()
activate IAM
IAM --> AUTH: 1.1.2: valid JWT token
deactivate IAM
AUTH --> COMP: 1.1.3: token
deactivate AUTH

COMP -> SVC: 1.2: getById(planId)
activate SVC
SVC --> COMP: 1.2.1: plan with operations
deactivate SVC

COMP -> COMP: 1.3: extractPlanMetadata()
note right
    - VVN details
    - Vessel info
    - Assigned dock
    - ETA/ETD
end note

COMP -> TIMELINE: 1.4: renderOperationsTimeline(operations)
activate TIMELINE
TIMELINE --> COMP: 1.5: timeline rendered
deactivate TIMELINE

COMP --> USER: 1.6: display plan header + operations timeline
deactivate COMP

USER -> TIMELINE: 2: hover/click operation in timeline
activate TIMELINE
TIMELINE --> USER: 2.1: show operation tooltip/details
deactivate TIMELINE

USER -> COMP: 3: click "Edit Plan" button
activate COMP
COMP -> COMP: 3.1: router.navigate(['/operation-plans', planId, 'edit'])
COMP --> USER: 3.2: navigate to edit page
deactivate COMP

@enduml
