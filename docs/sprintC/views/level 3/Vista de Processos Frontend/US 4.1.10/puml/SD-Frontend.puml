@startuml Vista de Processos Frontend – US 4.1.10 (Search VVEs - SPA)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
	ArrowColor Black
	ActorBorderColor #000000
	ActorBackgroundColor #87CEEB
	LifeLineBorderColor Black
	LifeLineBackgroundColor #87CEEB
	ParticipantBorderColor Black
	ParticipantBackgroundColor #87CEEB
	ParticipantFontStyle bold
}

actor "Logistics Operator" as USER

box "SPA (Angular)" #LightBlue
    participant "VesselVisitExecutionsListComponent" as COMP
    participant "VesselVisitExecutionService" as VVE_SVC
    participant "AuthService" as AUTH
    participant "MatTableDataSource" as TABLE
end box

participant "<<external>>\nIAM" as IAM #F5F5DC

USER -> COMP: 1: navigate to /vessel-visit-executions
activate COMP

COMP -> AUTH: 1.1: getToken()
activate AUTH
AUTH --> COMP: 1.1.1: token
deactivate AUTH

COMP -> COMP: 1.2: initializeSearchForm()
note right
    Form fields:
    - startDate
    - endDate
    - vesselImo
    - status (InProgress/Completed)
end note

COMP --> USER: 1.3: display search form and empty results table
deactivate COMP

USER -> COMP: 2: enter search criteria, click "Search"
activate COMP

COMP -> VVE_SVC: 2.1: searchWithMetrics(startDate, endDate, vesselImo, status)
activate VVE_SVC
VVE_SVC --> COMP: 2.1.1: VVE results with metrics
deactivate VVE_SVC

COMP -> TABLE: 2.2: setData(results)
activate TABLE
TABLE --> COMP: 2.2.1: data loaded
deactivate TABLE

COMP --> USER: 2.3: display results with metrics columns
note right
    Displayed metrics:
    - Total Turnaround Time (hours)
    - Berth Occupancy Time (hours)
    - Waiting Time for Berthing (hours)
    - Arrival Delay (hours)
    - Departure Delay (hours)
    - Executed Operations Count
end note
deactivate COMP

USER -> COMP: 3: click column header to sort
activate COMP
COMP -> TABLE: 3.1: sort(column, direction)
activate TABLE
TABLE --> COMP: 3.1.1: sorted data
deactivate TABLE
COMP --> USER: 3.2: display sorted results
deactivate COMP

USER -> COMP: 4: click row to view VVE details
activate COMP
COMP -> COMP: 4.1: router.navigate(['/vessel-visit-executions', vve.id])
COMP --> USER: 4.2: navigate to VVE detail page
deactivate COMP

@enduml
