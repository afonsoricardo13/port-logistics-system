@startuml Vista de Processos – Level 3 (US 4.1.9 – Update VVE Executed Operations)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
	ArrowColor Black
	ActorBorderColor #000000
	ActorBackgroundColor #87CEEB
	LifeLineBorderColor Black
	LifeLineBackgroundColor #87CEEB
	ParticipantBorderColor Black
	ParticipantBackgroundColor #87CEEB
	ParticipantFontStyle bold
}

participant "«container (C4)»\nSPA (Web UI)" as UI #87CEEB
participant "«component»\nExecutedOperationsController" as EO_CTRL #87CEEB
participant "«component»\nExecutedOperationService" as EO_SVC #87CEEB
participant "«component»\nOperationPlanService" as OP_SVC #87CEEB
participant "«component»\nExecutedOperation" as EO_DOMAIN #87CEEB
participant "«component»\nIExecutedOperationRepository" as EO_REPO #87CEEB
participant "«component»\nOEMDbContext" as DB_CTX #87CEEB
participant "«external»\nIAM" as IAM #F5F5DC

-> UI: 1: request to record executed operations for VVE
activate UI
UI -> IAM: 1.1: validate token
activate IAM
IAM --> UI: 1.1.1: token valid
deactivate IAM

UI -> OP_SVC: 1.2: GET /api/operationplans/by-vvn/{vvnId}
activate OP_SVC
OP_SVC --> UI: 1.2.1: planned operations
deactivate OP_SVC

UI --> : 1.3: display operations with editable times/resources
deactivate UI

-> UI: 2: confirm/modify operation execution details
activate UI

alt Initialize from plan
    UI -> EO_CTRL: 2.1a: POST /api/executedoperations/initialize-from-plan
    activate EO_CTRL
    EO_CTRL -> EO_SVC: 2.1a.1: InitializeOperationsFromPlanAsync(vveId, planId, user)
    activate EO_SVC
    loop for each planned operation
        EO_SVC -> EO_DOMAIN: 2.1a.1.1: CreateFromPlan(plannedOp)
        activate EO_DOMAIN
        EO_DOMAIN -> EO_DOMAIN: 2.1a.1.1.1: SetStatus(NotStarted)
        EO_DOMAIN --> EO_SVC: 2.1a.1.2: ExecutedOperation
        deactivate EO_DOMAIN
        EO_SVC -> EO_REPO: 2.1a.1.3: AddAsync(execOp)
        activate EO_REPO
        EO_REPO --> EO_SVC: 2.1a.1.4: saved
        deactivate EO_REPO
    end
    EO_SVC --> EO_CTRL: 2.1a.2: InitializeOperationsResponse
    deactivate EO_SVC
    EO_CTRL --> UI: 2.1a.3: operations initialized
    deactivate EO_CTRL
else Update individual operation
    UI -> EO_CTRL: 2.1b: PUT /api/executedoperations/{id}
    activate EO_CTRL
    EO_CTRL -> EO_SVC: 2.1b.1: UpdateAsync(id, dto, user)
    activate EO_SVC
    EO_SVC -> EO_REPO: 2.1b.1.1: GetByIdAsync(id)
    activate EO_REPO
    EO_REPO --> EO_SVC: 2.1b.1.2: ExecutedOperation
    deactivate EO_REPO
    EO_SVC -> EO_DOMAIN: 2.1b.1.3: UpdateExecution(times, resources)
    activate EO_DOMAIN
    EO_DOMAIN -> EO_DOMAIN: 2.1b.1.3.1: UpdateStatus (Started/Completed/Delayed)
    EO_DOMAIN --> EO_SVC: 2.1b.1.4: updated
    deactivate EO_DOMAIN
    EO_SVC -> EO_REPO: 2.1b.1.5: UpdateAsync(execOp)
    activate EO_REPO
    EO_REPO -> DB_CTX: 2.1b.1.5.1: SaveChangesAsync()
    activate DB_CTX
    DB_CTX --> EO_REPO: 2.1b.1.5.2: saved with timestamp
    deactivate DB_CTX
    EO_REPO --> EO_SVC: 2.1b.1.6: updated
    deactivate EO_REPO
    EO_SVC --> EO_CTRL: 2.1b.2: ExecutedOperationDTO
    deactivate EO_SVC
    EO_CTRL --> UI: 2.1b.3: 200 OK
    deactivate EO_CTRL
end

UI --> : 2.2: display updated execution progress
deactivate UI

@enduml
