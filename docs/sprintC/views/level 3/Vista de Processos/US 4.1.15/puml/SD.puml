@startuml SD - US 4.1.15 - Record Complementary Tasks (Level 3)
skinparam shadowing true
skinparam sequence {
	ArrowColor Black
	ActorBorderColor #000000
	ActorBackgroundColor #87CEEB
	LifeLineBorderColor Black
	LifeLineBackgroundColor #87CEEB
	ParticipantBorderColor Black
	ParticipantBackgroundColor #87CEEB
	ParticipantFontStyle bold
}

title US 4.1.15 - Record Complementary Tasks (SD Level 3 - OEM Backend)

actor "Logistics Operator" as LO

box "SPA (Angular)" #LightBlue
    participant "ComplementaryTasksComponent" as COMP
end box

box "OEM Backend" #LightGreen
    participant "ComplementaryTasksController" as CTRL
    participant "ComplementaryTaskService" as SVC
    participant "IComplementaryTaskRepository" as REPO
    participant "IComplementaryTaskCategoryRepository" as CAT_REPO
    participant "IVesselVisitExecutionRepository" as VVE_REPO
end box

database "«internal»\nOEM DB" as DB #87CEEB

LO -> COMP: 1: createTask(vveId, taskData)
activate COMP

COMP -> CTRL: 1.1: POST /api/complementary-tasks
activate CTRL

CTRL -> SVC: 1.2: CreateAsync(createTaskDTO)
activate SVC

SVC -> VVE_REPO: 1.3: GetByIdAsync(vveId)
activate VVE_REPO
VVE_REPO -> DB: 1.4: SELECT VVE
activate DB
DB --> VVE_REPO: 1.5: VVE
deactivate DB
VVE_REPO --> SVC: 1.6: VesselVisitExecution
deactivate VVE_REPO

SVC -> SVC: 1.7: validateVveStatus(vve)
note right: VVE must be InProgress

SVC -> CAT_REPO: 1.8: GetByCodeAsync(categoryCode)
activate CAT_REPO
CAT_REPO -> DB: 1.9: SELECT Category
activate DB
DB --> CAT_REPO: 1.10: Category
deactivate DB
CAT_REPO --> SVC: 1.11: ComplementaryTaskCategory
deactivate CAT_REPO

SVC -> SVC: 1.12: createTask(vve, category, taskData)

SVC -> REPO: 1.13: AddAsync(task)
activate REPO
REPO -> DB: 1.14: INSERT INTO ComplementaryTasks
activate DB
DB --> REPO: 1.15: created task
deactivate DB
REPO --> SVC: 1.16: ComplementaryTask
deactivate REPO

SVC --> CTRL: 1.17: ComplementaryTaskDTO
deactivate SVC

CTRL --> COMP: 1.18: 201 Created (task)
deactivate CTRL

COMP --> LO: 1.19: display new task, success notification
deactivate COMP

@enduml
