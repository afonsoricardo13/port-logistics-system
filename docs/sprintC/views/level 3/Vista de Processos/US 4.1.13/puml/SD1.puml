@startuml Vista de Processos – Level 3 (US 4.1.13 – Record Incidents)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
	ArrowColor Black
	ActorBorderColor #000000
	ActorBackgroundColor #87CEEB
	LifeLineBorderColor Black
	LifeLineBackgroundColor #87CEEB
	ParticipantBorderColor Black
	ParticipantBackgroundColor #87CEEB
	ParticipantFontStyle bold
}

participant "«container (C4)»\nSPA (Web UI)" as UI #87CEEB
participant "«component»\nIncidentsController" as INC_CTRL #87CEEB
participant "«component»\nIncidentService" as INC_SVC #87CEEB
participant "«component»\nIncident" as INC_DOMAIN #87CEEB
participant "«component»\nIIncidentRepository" as INC_REPO #87CEEB
participant "«component»\nIIncidentTypeRepository" as IT_REPO #87CEEB
participant "«component»\nIVesselVisitExecutionRepository" as VVE_REPO #87CEEB
participant "«component»\nOEMDbContext" as DB_CTX #87CEEB
participant "«external»\nIAM" as IAM #F5F5DC

-> UI: 1: request to record new incident
activate UI
UI -> IAM: 1.1: validate token
activate IAM
IAM --> UI: 1.1.1: token valid, extract user email
deactivate IAM

UI --> : 1.2: display incident form
deactivate UI

-> UI: 2: provide incident details
activate UI
UI -> INC_CTRL: 2.1: POST /api/incidents (CreateIncidentDTO)
activate INC_CTRL
INC_CTRL -> INC_SVC: 2.1.1: CreateAsync(dto, userEmail)
activate INC_SVC

INC_SVC -> IT_REPO: 2.1.1.1: GetByCodeAsync(incidentTypeCode)
activate IT_REPO
IT_REPO --> INC_SVC: 2.1.1.2: IncidentType
deactivate IT_REPO

alt IncidentType not found
    INC_SVC --> INC_CTRL: 2.1.1.3: throw ArgumentException
    INC_CTRL --> UI: 2.2a: 400 Bad Request
end

loop for each affected VVE ID
    INC_SVC -> VVE_REPO: 2.1.1.4: GetByIdAsync(vveId)
    activate VVE_REPO
    VVE_REPO --> INC_SVC: 2.1.1.5: VVE exists
    deactivate VVE_REPO
end

INC_SVC -> INC_DOMAIN: 2.1.1.6: new Incident(type, severity, description, user)
activate INC_DOMAIN
INC_DOMAIN -> INC_DOMAIN: 2.1.1.6.1: GenerateId()
INC_DOMAIN -> INC_DOMAIN: 2.1.1.6.2: SetStartTime(now)
INC_DOMAIN -> INC_DOMAIN: 2.1.1.6.3: AddAffectedVves(vveIds)
INC_DOMAIN --> INC_SVC: 2.1.1.7: Incident entity
deactivate INC_DOMAIN

INC_SVC -> INC_REPO: 2.1.1.8: AddAsync(incident)
activate INC_REPO
INC_REPO -> DB_CTX: 2.1.1.8.1: Add(incident)
activate DB_CTX
DB_CTX --> INC_REPO: 2.1.1.8.2: saved
deactivate DB_CTX
INC_REPO --> INC_SVC: 2.1.1.9: persisted
deactivate INC_REPO

INC_SVC --> INC_CTRL: 2.1.2: IncidentDTO
deactivate INC_SVC
INC_CTRL --> UI: 2.2b: 201 Created
deactivate INC_CTRL

UI --> : 2.3: display incident confirmation
deactivate UI

@enduml
