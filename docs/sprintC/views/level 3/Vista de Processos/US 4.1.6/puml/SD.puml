@startuml SD - US 4.1.6 - View Missing Operation Plans (Level 3)
skinparam shadowing true
skinparam sequence {
	ArrowColor Black
	ActorBorderColor #000000
	ActorBackgroundColor #87CEEB
	LifeLineBorderColor Black
	LifeLineBackgroundColor #87CEEB
	ParticipantBorderColor Black
	ParticipantBackgroundColor #87CEEB
	ParticipantFontStyle bold
}

title US 4.1.6 - View Missing Operation Plans (SD Level 3 - OEM Backend)

actor "Logistics Operator" as LO

box "SPA (Angular)" #LightBlue
    participant "MissingPlansComponent" as COMP
end box

box "OEM Backend" #LightGreen
    participant "OperationPlansController" as CTRL
    participant "OperationPlanService" as SVC
    participant "PortLogisticsClient" as PL_CLIENT
    participant "IOperationPlanRepository" as REPO
end box

database "«internal»\nOEM DB" as DB #87CEEB

LO -> COMP: 1: loadMissingPlans(date)
activate COMP

COMP -> CTRL: 1.1: GET /api/operation-plans/missing?date={date}
activate CTRL

CTRL -> SVC: 1.2: GetMissingPlansAsync(date)
activate SVC

SVC -> PL_CLIENT: 1.3: GetApprovedVvnsAsync(date)
activate PL_CLIENT
PL_CLIENT --> SVC: 1.4: List<VvnDTO>
deactivate PL_CLIENT

SVC -> REPO: 1.5: GetVvnIdsWithPlansAsync(date)
activate REPO
REPO -> DB: 1.6: SELECT VvnId FROM OperationPlans WHERE Date = @date
activate DB
DB --> REPO: 1.7: vvnIds with plans
deactivate DB
REPO --> SVC: 1.8: List<Guid>
deactivate REPO

SVC -> SVC: 1.9: filterMissingPlans(vvns, existingVvnIds)
note right
    Returns VVNs that:
    - Are approved
    - Have ETA on selected date
    - Don't have operation plan yet
end note

SVC --> CTRL: 1.10: List<VvnWithoutPlanDTO>
deactivate SVC

CTRL --> COMP: 1.11: 200 OK (missingPlans)
deactivate CTRL

COMP --> LO: 1.12: display VVNs without plans
deactivate COMP

@enduml
