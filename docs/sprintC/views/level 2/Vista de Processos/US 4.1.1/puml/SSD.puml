@startuml SSD - US 4.1.1 - View Daily Operation Plans (Level 2)
skinparam shadowing true
skinparam sequence {
	ArrowColor Black
	ActorBorderColor #000000
	ActorBackgroundColor #87CEEB
	LifeLineBorderColor Black
	LifeLineBackgroundColor #87CEEB
	ParticipantBorderColor Black
	ParticipantBackgroundColor #87CEEB
	ParticipantFontStyle bold
}

title US 4.1.1 - View Daily Operation Plans (SSD Level 2)

actor "Logistics Operator" as LO

box "Port Operations System" #LightBlue
    participant "SPA\n(Angular)" as SPA
    participant "OEM\nBackend" as OEM
end box

participant "«external»\nIAM" as IAM #F5F5DC

database "«internal»\nOEM DB" as DB #87CEEB

LO -> SPA: 1: navigate to daily plans (date)
activate SPA

SPA -> IAM: 1.1: validateSession()
activate IAM
IAM --> SPA: 1.2: valid token
deactivate IAM

SPA -> OEM: 1.3: GET /api/operation-plans?date={date}
activate OEM

OEM -> DB: 1.4: query plans by date
activate DB
DB --> OEM: 1.5: operation plans
deactivate DB

OEM --> SPA: 1.6: operation plans list
deactivate OEM

SPA --> LO: 1.7: display daily plans with VVN info
deactivate SPA

@enduml
