@startuml SSD - US 4.1.5 - Edit Operation Plan (Level 2)
skinparam shadowing true
skinparam sequence {
	ArrowColor Black
	ActorBorderColor #000000
	ActorBackgroundColor #87CEEB
	LifeLineBorderColor Black
	LifeLineBackgroundColor #87CEEB
	ParticipantBorderColor Black
	ParticipantBackgroundColor #87CEEB
	ParticipantFontStyle bold
}

title US 4.1.5 - Edit Operation Plan (SSD Level 2)

actor "Logistics Operator" as LO

box "Port Operations System" #LightBlue
    participant "SPA\n(Angular)" as SPA
    participant "OEM\nBackend" as OEM
end box

participant "«external»\nIAM" as IAM #F5F5DC

database "«internal»\nOEM DB" as DB #87CEEB

LO -> SPA: 1: edit operation plan (planId, updates)
activate SPA

SPA -> IAM: 1.1: validateSession()
activate IAM
IAM --> SPA: 1.2: valid token
deactivate IAM

SPA -> OEM: 1.3: PUT /api/operation-plans/{planId}
activate OEM

OEM -> OEM: 1.4: validate plan updates
note right
    Validations:
    - Times within VVN window
    - Resources available
    - No conflicting operations
end note

OEM -> DB: 1.5: update plan and operations
activate DB
DB --> OEM: 1.6: updated plan
deactivate DB

OEM --> SPA: 1.7: updated operation plan
deactivate OEM

SPA --> LO: 1.8: display updated plan, show success
deactivate SPA

@enduml
