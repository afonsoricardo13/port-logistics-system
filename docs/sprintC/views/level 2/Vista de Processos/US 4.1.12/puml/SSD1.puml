@startuml Vista de Processos – Level 2 (US 4.1.12 – Manage Incident Types)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
    ArrowColor Black
    ActorBorderColor #000000
    ActorBackgroundColor #87CEEB
    LifeLineBorderColor Black
    LifeLineBackgroundColor #87CEEB
    ParticipantBorderColor Black
    ParticipantBackgroundColor #87CEEB
    ParticipantFontStyle bold
}

participant "<<container (C4)>>\nSPA (Web UI)" as UI #87CEEB
participant "<<container (C4)>>\nOEM (Backend)" as OEM #87CEEB
participant "<<external>>\nIAM" as IAM #F5F5DC

-> UI: 1: request to manage Incident Types
activate UI
UI -> IAM: 1.1: validate token
activate IAM
IAM --> UI: 1.1.1: token valid
deactivate IAM

UI -> OEM: 1.2: GET /api/incidenttypes
activate OEM
OEM --> UI: 1.2.1: hierarchical list of Incident Types
deactivate OEM
UI --> : 1.3: display Incident Types tree view
deactivate UI

-> UI: 2: perform CRUD operation
activate UI

alt Create new type
    UI -> OEM: 2.1a: POST /api/incidenttypes (code, name, severity, parentCode)
    activate OEM
    OEM --> UI: 2.1a.1: type created
    deactivate OEM
else Update type
    UI -> OEM: 2.1b: PUT /api/incidenttypes/{code}
    activate OEM
    OEM --> UI: 2.1b.1: type updated
    deactivate OEM
else Delete type
    UI -> OEM: 2.1c: DELETE /api/incidenttypes/{code}
    activate OEM
    OEM --> UI: 2.1c.1: type deleted
    deactivate OEM
end

UI --> : 2.2: display confirmation
deactivate UI

@enduml
