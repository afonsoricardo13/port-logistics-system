@startuml Vista de Processos – Level 2 (US 4.1.7 – Create VVE)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
    ArrowColor Black
    ActorBorderColor #000000
    ActorBackgroundColor #87CEEB
    LifeLineBorderColor Black
    LifeLineBackgroundColor #87CEEB
    ParticipantBorderColor Black
    ParticipantBackgroundColor #87CEEB
    ParticipantFontStyle bold
}

participant "<<container (C4)>>\nSPA (Web UI)" as UI #87CEEB
participant "<<container (C4)>>\nOEM (Backend)" as OEM #87CEEB
participant "<<container (C4)>>\nPort Logistics (Backend)" as PORT #87CEEB
participant "<<external>>\nIAM" as IAM #F5F5DC

-> UI: 1: request to create VVE for arriving vessel
activate UI
UI -> IAM: 1.1: validate token
activate IAM
IAM --> UI: 1.1.1: token valid
deactivate IAM

UI -> PORT: 1.2: GET /api/vesselvisitnotifications (approved)
activate PORT
PORT --> UI: 1.2.1: list of approved VVNs
deactivate PORT

UI --> : 1.3: display VVN selection form
deactivate UI

-> UI: 2: select VVN and provide arrival time
activate UI
UI -> OEM: 2.1: POST /api/vesselvisitexecutions (vvnId, arrivalTime)
activate OEM
OEM -> PORT: 2.1.1: GET /api/vesselvisitnotifications/{vvnId}
activate PORT
PORT --> OEM: 2.1.2: VVN details
deactivate PORT
OEM --> UI: 2.2: VVE created (status: InProgress)
deactivate OEM
UI --> : 2.3: display VVE confirmation
deactivate UI

@enduml
