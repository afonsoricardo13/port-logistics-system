@startuml Vista de Processos – Level 1 (US 4.1.14 – Manage Complementary Task Categories)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
    ArrowColor Black
    ActorBorderColor #000000
    ActorBackgroundColor #87CEEB
    LifeLineBorderColor Black
    LifeLineBackgroundColor #87CEEB
    ParticipantBorderColor Black
    ParticipantBackgroundColor #87CEEB
    ParticipantFontStyle bold
}

actor "Port Operations Supervisor" as POS
participant "«system (C4)»\nPort Operations System" as SYS #87CEEB
participant "«external»\nIAM" as IAM #F5F5DC

POS -> SYS: 1: request to manage Complementary Task Categories
activate SYS
SYS -> IAM: 1.1: validateToken()
activate IAM
IAM --> SYS: 1.2: tokenValid
deactivate IAM
SYS --> POS: 1.3: displays list of task categories
deactivate SYS
POS -> SYS: 2: performs CRUD operation (create/update/delete)
activate SYS
SYS --> POS: 2.1: confirmation of operation
deactivate SYS

@enduml
