@startuml Vista de Processos – Level 1 (US 4.1.9 – Update VVE Executed Operations)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
    ArrowColor Black
    ActorBorderColor #000000
    ActorBackgroundColor #87CEEB
    LifeLineBorderColor Black
    LifeLineBackgroundColor #87CEEB
    ParticipantBorderColor Black
    ParticipantBackgroundColor #87CEEB
    ParticipantFontStyle bold
}

actor "Logistics Operator" as LO
participant "«system (C4)»\nPort Operations System" as SYS #87CEEB
participant "«external»\nIAM" as IAM #F5F5DC

LO -> SYS: 1: request to update VVE with executed operations
activate SYS
SYS -> IAM: 1.1: validateToken()
activate IAM
IAM --> SYS: 1.2: tokenValid
deactivate IAM
SYS --> LO: 1.3: shows planned operations for confirmation/modification
deactivate SYS
LO -> SYS: 2: confirms/modifies operation times and resources
activate SYS
SYS --> LO: 2.1: executed operations recorded with status update
deactivate SYS

@enduml
