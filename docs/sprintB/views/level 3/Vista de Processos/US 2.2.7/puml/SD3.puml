@startuml Vista de Processos – Level 3 (US 2.2.7 – Reject Vessel Visit Notification)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
    ArrowColor Black
    ActorBorderColor #000000
    ActorBackgroundColor #87CEEB
    LifeLineBorderColor Black
    LifeLineBackgroundColor #87CEEB
    ParticipantBorderColor Black
    ParticipantBackgroundColor #87CEEB
    ParticipantFontStyle bold
}

actor "Port Authority Officer" as Officer
participant "«container (C4)»\nVisualization (UI)" as UI_CTRL #87CEEB
participant "«container (C4)»\nVisits & Manifests\nController" as VVN_CTRL #87CEEB
participant "«component»\nApplication Service" as VVN_APP #87CEEB
participant "«component»\nDomain Model\n(VesselVisitNotification)" as VVN_DOMAIN #87CEEB
participant "«component»\nDomain Model\n(DecisionLog)" as DL_DOMAIN #87CEEB
participant "«component»\nRepository" as VVN_REPO #87CEEB
participant "«component»\nData Model" as VVN_DATA #87CEEB
participant "«component»\nPersistence" as VVN_PERSIST #87CEEB

activate Officer
Officer -> UI_CTRL: 1: select notification to reject
activate UI_CTRL
UI_CTRL --> Officer: 1.1: show notification details
deactivate UI_CTRL

Officer -> UI_CTRL: 2: provide rejection reason and reject
activate UI_CTRL
UI_CTRL -> VVN_CTRL: 2.1: POST /api/vessel-visits/notifications/{id}/reject\n(RejectNotificationDTO: reason, officerId)
activate VVN_CTRL
VVN_CTRL -> VVN_APP: 2.1.1: rejectNotification(notificationId, reason, officerId)
activate VVN_APP
VVN_APP -> VVN_REPO: 2.1.1.1: getById(notificationId)
activate VVN_REPO
VVN_REPO -> VVN_PERSIST: 2.1.1.1.1: fetch(record)
activate VVN_PERSIST
VVN_PERSIST --> VVN_REPO: 2.1.1.1.2: record
deactivate VVN_PERSIST
VVN_REPO -> VVN_DATA: 2.1.1.1.3: map to domain
activate VVN_DATA
VVN_DATA --> VVN_REPO: 2.1.1.1.4: VesselVisitNotification aggregate
deactivate VVN_DATA
VVN_REPO --> VVN_APP: 2.1.1.2: notification aggregate
deactivate VVN_REPO
VVN_APP -> DL_DOMAIN: 2.1.1.3: create DecisionLog\n(officerId, REJECTED, null, reason, timestamp)
activate DL_DOMAIN
DL_DOMAIN --> VVN_APP: 2.1.1.4: DecisionLog value object
deactivate DL_DOMAIN
VVN_APP -> VVN_DOMAIN: 2.1.1.5: reject(decisionLog)
activate VVN_DOMAIN
VVN_DOMAIN --> VVN_APP: 2.1.1.6: notification rejected\n(status = REJECTED, reason logged)
deactivate VVN_DOMAIN
VVN_APP -> VVN_REPO: 2.1.1.7: save(rejected notification)
activate VVN_REPO
VVN_REPO -> VVN_DATA: 2.1.1.7.1: map to data model
activate VVN_DATA
VVN_DATA --> VVN_REPO: 2.1.1.7.2: updated record
deactivate VVN_DATA
VVN_REPO -> VVN_PERSIST: 2.1.1.7.3: persist(updated record)
activate VVN_PERSIST
VVN_PERSIST --> VVN_REPO: 2.1.1.7.4: ok
deactivate VVN_PERSIST
VVN_REPO --> VVN_APP: 2.1.1.8: persisted
deactivate VVN_REPO
VVN_APP --> VVN_CTRL: 2.1.2: rejection confirmation (VesselVisitNotificationDTO)
deactivate VVN_APP
VVN_CTRL --> UI_CTRL: 2.2: HTTP 200 OK (notification rejected)
deactivate VVN_CTRL
UI_CTRL --> Officer: 2.3: display rejection confirmation
deactivate UI_CTRL
deactivate Officer

@enduml
