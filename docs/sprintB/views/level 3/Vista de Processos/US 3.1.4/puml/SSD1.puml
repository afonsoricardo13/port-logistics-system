@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

actor "System User" as User
participant "Angular Component" as UI
participant "Model" as Model
participant "Frontend Service" as FS
participant "HTTP Driver" as HTTP
participant "Controller" as Backend
participant "Domain" as Domain
participant "Backend Service" as BS
participant "Repository" as Repo
participant "Database" as DB

activate User
User -> UI : complete action

activate UI
UI -> Model : validate and prepare data

activate Model
Model --> UI : return prepared data
deactivate Model

UI -> FS : send data for processing  

activate FS
FS -> HTTP : make request with data

activate HTTP
HTTP -> Backend : send request to process action

activate Backend
Backend -> Domain : validate and prepare data

activate Domain
Domain --> Backend : return prepared data
deactivate Domain

Backend -> BS : process action with data

activate BS
BS -> Repo : interact with data storage

activate Repo
Repo -> DB : query/update data as needed

activate DB
DB --> Repo : return result of query/update
deactivate DB

Repo --> BS : return result of data interaction
deactivate Repo

BS --> Backend : return result of action processing
deactivate BS

Backend --> HTTP : return result of action
deactivate Backend

HTTP --> FS : return result of request
deactivate HTTP

FS --> UI : return result of processing
deactivate FS

UI --> User : retrieve clear feedback on action success or failure
deactivate UI

deactivate User

@enduml