@startuml Vista de Processos – Level 3 (US 2.2.8 – Create Vessel Visit Notification)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
	ArrowColor Black
	ActorBorderColor #000000
	ActorBackgroundColor #87CEEB
	LifeLineBorderColor Black
	LifeLineBackgroundColor #87CEEB
	ParticipantBorderColor Black
	ParticipantBackgroundColor #87CEEB
	ParticipantFontStyle bold
}

participant "«container (C4)»\nSPA (Web UI)" as UI #87CEEB
participant "«component»\nController" as CTRL #87CEEB
participant "«component»\nApplication Service" as VVN_APP #87CEEB
participant "«component»\nDomain Model (VesselVisitNotification)" as VVN_DOMAIN #87CEEB
participant "«component»\nRepository" as VVN_REPO #87CEEB
participant "«component»\nData Model" as VVN_DATA #87CEEB
participant "«component»\nPersistence" as VVN_PERSIST #87CEEB

-> UI: 1: asks to create a Vessel Visit Notification (VVN)
activate UI
UI --> : 1.1: ask for required data (Vessel, ETA/ETD, cargo manifest, crew info when needed)
deactivate UI
-> UI: 2: provides VVN data (may be incomplete)
activate UI
UI -> CTRL: 2.1: save VVN with "in progress" status (VesselVisitNotificationDTO)
activate CTRL
CTRL -> VVN_APP: 2.1.1: createVesselVisitNotification(VesselVisitNotificationDTO)
activate VVN_APP
VVN_APP -> VVN_DOMAIN: 2.1.1.1: create aggregate; set status IN PROGRESS
activate VVN_DOMAIN
VVN_DOMAIN --> VVN_APP: 2.1.1.2: VVN aggregate
deactivate VVN_DOMAIN
VVN_APP -> VVN_REPO: 2.1.1.3: save(vvn)
activate VVN_REPO
VVN_REPO -> VVN_DATA: 2.1.1.3.1: map to data model
activate VVN_DATA
VVN_DATA --> VVN_REPO: 2.1.1.3.2: VVN record
deactivate VVN_DATA
VVN_REPO -> VVN_PERSIST: 2.1.1.3.3: persist(record)
activate VVN_PERSIST
VVN_PERSIST --> VVN_REPO: 2.1.1.3.4: ok
deactivate VVN_PERSIST
VVN_REPO --> VVN_APP: 2.1.1.4: persisted(vvn)
deactivate VVN_REPO
VVN_APP --> CTRL: 2.1.2: creation confirmation (VesselVisitNotificationDTO)
deactivate VVN_APP
CTRL --> UI: 2.2: creation confirmation (VVN with status IN PROGRESS)
deactivate CTRL
UI --> : 2.3: show VVN created
deactivate UI

@enduml