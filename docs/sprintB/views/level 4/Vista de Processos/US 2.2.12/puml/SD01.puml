@startuml Vista de Processos - Level 4 (US 2.2.12 - Register Physical Resource)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
    ArrowColor Black
    ActorBorderColor #000000
    ActorBackgroundColor #87CEEB
    LifeLineBorderColor Black
    LifeLineBackgroundColor #87CEEB
    ParticipantBorderColor Black
    ParticipantBackgroundColor #87CEEB
    ParticipantFontStyle bold
}

actor "Logistics Operator" as LO
participant "<<container (C4)>>\nSPA (Web UI)" as UI_CTRL #87CEEB
participant "<<container (C4)>>\nPort Logistics (Backend)\nController" as MDR_CTRL #87CEEB
participant "<<component>>\nApplication Service" as MDR_APP #87CEEB
participant "<<component>>\nDomain Model (PhysicalResource)" as MDR_DOMAIN #87CEEB
participant "<<component>>\nRepository" as MDR_REPO #87CEEB
participant "<<component>>\nData Model" as MDR_DATA #87CEEB
participant "<<component>>\nPersistence" as MDR_PERSIST #87CEEB

activate LO
LO -> UI_CTRL: 1: POST /api/PhysicalResources\n{code, description, type, capacity, assignedArea, setupTimeMinutes, qualificationRequirementIds[]}
activate UI_CTRL
UI_CTRL -> MDR_CTRL: 1.1: createPhysicalResource(dto)
activate MDR_CTRL
MDR_CTRL -> MDR_APP: 1.1.1: createPhysicalResource(dto)
activate MDR_APP

MDR_APP -> MDR_REPO: 1.1.1.1: existsByCode(dto.code)
activate MDR_REPO
MDR_REPO -> MDR_PERSIST: 1.1.1.1.1: query code uniqueness
activate MDR_PERSIST
MDR_PERSIST --> MDR_REPO: 1.1.1.1.2: exists? (true/false)
deactivate MDR_PERSIST
MDR_REPO --> MDR_APP: 1.1.1.1.3: exists
deactivate MDR_REPO

alt code already exists
  MDR_APP --> MDR_CTRL: 1.1.1.a: BusinessRuleValidationException\n"Code already exists"
  MDR_CTRL --> UI_CTRL: 1.1.a: HTTP 400 Bad Request
  UI_CTRL --> LO: 1.1.b: show error "Code already in use"
else new code

  MDR_APP -> MDR_DOMAIN: 1.1.1.2: build PhysicalResource aggregate (dto)
  activate MDR_DOMAIN
  MDR_DOMAIN -> MDR_DOMAIN: validate code alphanumeric & not empty\nvalidate description not empty\nvalidate type (Crane/Truck/Forklift)\nvalidate capacity > 0\nvalidate setupTimeMinutes >= 0
  
  alt invalid data
    MDR_DOMAIN --> MDR_APP: 1.1.1.2.a: ArgumentException\n"Invalid resource data"
    MDR_APP --> MDR_CTRL: 1.1.1.b: validation error
    MDR_CTRL --> UI_CTRL: 1.1.c: HTTP 400 Bad Request
    UI_CTRL --> LO: 1.1.d: show validation errors
  else valid aggregate
    MDR_DOMAIN -> MDR_DOMAIN: set Status = Active\nset ChangedAt = now\nset ChangedBy = operator\nset OperationType = "CREATE"
    
    loop for each qualification requirement
      MDR_DOMAIN -> MDR_DOMAIN: validate qualification exists\nadd to qualificationRequirementIds
    end
    
    MDR_DOMAIN --> MDR_APP: 1.1.1.2.1: PhysicalResource aggregate
    deactivate MDR_DOMAIN

    MDR_APP -> MDR_REPO: 1.1.1.3: add(resource)
    activate MDR_REPO
    MDR_REPO -> MDR_DATA: 1.1.1.3.1: map to data model
    activate MDR_DATA
    MDR_DATA --> MDR_REPO: 1.1.1.3.2: resource record
    deactivate MDR_DATA
    MDR_REPO -> MDR_PERSIST: 1.1.1.3.3: INSERT physical_resources\n(code, description, type, capacity, status, changedAt, changedBy, operationType)
    activate MDR_PERSIST
    MDR_PERSIST --> MDR_REPO: 1.1.1.3.4: persisted record
    deactivate MDR_PERSIST
    MDR_REPO --> MDR_APP: 1.1.1.3.5: persisted(resource)
    deactivate MDR_REPO

    MDR_APP --> MDR_CTRL: 1.1.2: created PhysicalResourceDTO
    deactivate MDR_APP
    MDR_CTRL --> UI_CTRL: 1.2: HTTP 201 Created\n(Location: /api/PhysicalResources/{code} + body)
    deactivate MDR_CTRL
    UI_CTRL --> LO: 1.3: show confirmation\n"Physical resource registered successfully"
  end
end

deactivate UI_CTRL
deactivate LO

note right of MDR_DOMAIN
  Business Rules enforced:
  - Code unique & alphanumeric (BR1)
  - Description required
  - Type: Crane, Truck, Forklift
  - Capacity > 0 (BR4)
  - SetupTime >= 0 (BR5)
  - Status = Active by default
  - Audit trail: changedAt, changedBy (BR7)
  - QualificationRequirements integrity (BR6)
end note

note right of MDR_APP
  Service coordination:
  - Check code uniqueness
  - Delegate validation to domain
  - Set audit fields
  - Persist via repository
  - Return DTO or errors
end note

@enduml
