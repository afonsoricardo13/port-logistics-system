@startuml Vista de Processos - Level 4 (US 2.2.12 - Update Physical Resource)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
    ArrowColor Black
    ActorBorderColor #000000
    ActorBackgroundColor #87CEEB
    LifeLineBorderColor Black
    LifeLineBackgroundColor #87CEEB
    ParticipantBorderColor Black
    ParticipantBackgroundColor #87CEEB
    ParticipantFontStyle bold
}

actor "Logistics Operator" as LO
participant "<<container (C4)>>\nSPA (Web UI)" as UI_CTRL #87CEEB
participant "<<container (C4)>>\nPort Logistics (Backend)\nController" as MDR_CTRL #87CEEB
participant "<<component>>\nApplication Service" as MDR_APP #87CEEB
participant "<<component>>\nDomain Model (PhysicalResource)" as MDR_DOMAIN #87CEEB
participant "<<component>>\nRepository" as MDR_REPO #87CEEB
participant "<<component>>\nData Model" as MDR_DATA #87CEEB
participant "<<component>>\nPersistence" as MDR_PERSIST #87CEEB

activate LO
LO -> UI_CTRL: 1: PUT /api/PhysicalResources/{code}\n{description, type, capacity, assignedArea, setupTimeMinutes, qualificationRequirementIds[]}
activate UI_CTRL
UI_CTRL -> MDR_CTRL: 1.1: updatePhysicalResource(code, dto)
activate MDR_CTRL
MDR_CTRL -> MDR_APP: 1.1.1: updatePhysicalResource(code, dto)
activate MDR_APP

MDR_APP -> MDR_REPO: 1.1.1.1: getByCodeAsync(code)
activate MDR_REPO
MDR_REPO -> MDR_PERSIST: 1.1.1.1.1: fetch resource record
activate MDR_PERSIST
MDR_PERSIST --> MDR_REPO: 1.1.1.1.2: record or null
deactivate MDR_PERSIST
MDR_REPO -> MDR_DATA: 1.1.1.1.3: map to domain
activate MDR_DATA
MDR_DATA --> MDR_REPO: 1.1.1.1.4: resource aggregate or null
deactivate MDR_DATA
MDR_REPO --> MDR_APP: 1.1.1.1.5: resource or null
deactivate MDR_REPO

alt resource not found
  MDR_APP --> MDR_CTRL: 1.1.1.a: NotFoundException\n"Physical resource not found"
  MDR_CTRL --> UI_CTRL: 1.1.a: HTTP 404 Not Found
  UI_CTRL --> LO: 1.1.b: show error
else resource found

  MDR_APP -> MDR_DOMAIN: 1.1.1.2: update(dto)
  activate MDR_DOMAIN
  MDR_DOMAIN -> MDR_DOMAIN: validate description not empty\nvalidate type (Crane/Truck/Forklift)\nvalidate capacity > 0\nvalidate setupTimeMinutes >= 0
  
  alt invalid data
    MDR_DOMAIN --> MDR_APP: 1.1.1.2.a: ArgumentException\n"Invalid resource data"
    MDR_APP --> MDR_CTRL: 1.1.1.b: validation error
    MDR_CTRL --> UI_CTRL: 1.1.c: HTTP 400 Bad Request
    UI_CTRL --> LO: 1.1.d: show validation errors
  else valid update
    MDR_DOMAIN -> MDR_DOMAIN: apply changes\nset ChangedAt = now\nset ChangedBy = operator\nset OperationType = "UPDATE"
    
    MDR_DOMAIN -> MDR_DOMAIN: clear existing qualifications
    loop for each new qualification requirement
      MDR_DOMAIN -> MDR_DOMAIN: validate qualification exists\nadd to qualificationRequirementIds
    end
    
    MDR_DOMAIN --> MDR_APP: 1.1.1.2.1: updated resource
    deactivate MDR_DOMAIN

    MDR_APP -> MDR_REPO: 1.1.1.3: update(resource, errorList)
    activate MDR_REPO
    MDR_REPO -> MDR_DATA: 1.1.1.3.1: map to data model
    activate MDR_DATA
    MDR_DATA --> MDR_REPO: 1.1.1.3.2: updated record
    deactivate MDR_DATA
    MDR_REPO -> MDR_PERSIST: 1.1.1.3.3: UPDATE physical_resources\nSET description, type, capacity, ..., changedAt, changedBy
    activate MDR_PERSIST
    MDR_PERSIST --> MDR_REPO: 1.1.1.3.4: ok
    deactivate MDR_PERSIST
    MDR_REPO --> MDR_APP: 1.1.1.3.5: persisted(updated resource)
    deactivate MDR_REPO

    MDR_APP --> MDR_CTRL: 1.1.2: updated PhysicalResourceDTO
    deactivate MDR_APP
    MDR_CTRL --> UI_CTRL: 1.2: HTTP 200 OK {code, description, ...}
    deactivate MDR_CTRL
    UI_CTRL --> LO: 1.3: show confirmation\n"Physical resource updated successfully"
  end
end

deactivate UI_CTRL
deactivate LO

note right of MDR_DOMAIN
  Update rules:
  - Resource must exist (404 if not)
  - Code cannot be changed (immutable)
  - All validations re-applied
  - Status preserved unless explicitly changed
  - Audit trail updated (BR7)
  - QualificationRequirements replaced
end note

note right of MDR_APP
  Service coordination:
  - Fetch existing resource
  - Delegate validation to domain
  - Update audit fields
  - Persist changes via repository
end note

@enduml
