' ===== Application Layer (Services & DTOs) =====
package "<<layer>> Application" #87CEEB {
  class PhysicalResourceService <<Service>> {
    - _repository: IPhysicalResourceRepository
    + CreatePhysicalResource(dto: CreatePhysicalResourceDTO): PhysicalResourceDTO
    + UpdatePhysicalResource(code: string, dto: UpdatePhysicalResourceDTO): PhysicalResourceDTO
    + DeactivatePhysicalResource(code: string): bool
    + ReactivatePhysicalResource(code: string): bool
    + GetPhysicalResource(code: string): PhysicalResourceDTO
    + ListPhysicalResources(filters: ResourceFilters): List<PhysicalResourceDTO>
  }

  interface IPhysicalResourceService {
    + CreatePhysicalResource(dto: CreatePhysicalResourceDTO): PhysicalResourceDTO
    + UpdatePhysicalResource(code: string, dto: UpdatePhysicalResourceDTO): PhysicalResourceDTO
    + DeactivatePhysicalResource(code: string): bool
  }

  class CreatePhysicalResourceDTO <<DTO>> {
    + Code: string
    + Description: string
    + Type: string
    + Capacity: int
    + AssignedArea: string
    + SetupTimeMinutes: int
    + QualificationRequirementIds: List<string>
  }

  class UpdatePhysicalResourceDTO <<DTO>> {
    + Description: string
    + Type: string
    + Capacity: int
    + AssignedArea: string
    + SetupTimeMinutes: int
    + QualificationRequirementIds: List<string>
  }

  class PhysicalResourceDTO <<DTO>> {
    + Code: string
    + Description: string
    + Type: string
    + Capacity: int
    + AssignedArea: string
    + Status: string
    + SetupTimeMinutes: int
    + QualificationRequirementIds: List<string>
    + ChangedAt: DateTime?
    + ChangedBy: string
    + OperationType: string
  }
}

' ===== Domain Layer (Aggregates, Entities, Value Objects) =====
package "<<layer>> Domain" #87CEEB {
  class PhysicalResource <<Aggregate Root>> {
    - _id: long
    - _code: string
    - _description: string
    - _type: string
    - _capacity: int
    - _assignedArea: string
    - _status: PhysicalResourceStatus
    - _setupTimeMinutes: int
    - _qualificationRequirementIds: List<string>
    - _changedAt: DateTime?
    - _changedBy: string
    - _operationType: string
    + PhysicalResource(code, description, type, capacity)
    + Update(description, type, capacity, ...): void
    + Deactivate(changedBy: string): void
    + Reactivate(changedBy: string): void
    + SetAssignedArea(area: string): void
    + SetQualifications(qualifications: List<string>): void
    + ValidateCode(): void
    + ValidateCapacity(): void
  }

  enum PhysicalResourceStatus {
    Active
    Inactive
    UnderMaintenance
  }

  interface IPhysicalResourceRepository <<Repository Interface>> {
    + GetAllAsync(): Task<List<PhysicalResource>>
    + GetByCodeAsync(code: string): Task<PhysicalResource>
    + ExistsByCode(code: string): Task<bool>
    + Add(resource: PhysicalResource): Task<PhysicalResource>
    + Update(resource: PhysicalResource, errors: List<string>): Task<PhysicalResource>
  }
}

' ===== Infrastructure Layer (Repositories & Persistence) =====
package "<<layer>> Infrastructure" #87CEEB {
  class PhysicalResourceRepository <<Repository>> {
    - _context: PortLogisticsContext
    + GetAllAsync(): Task<List<PhysicalResource>>
    + GetByCodeAsync(code: string): Task<PhysicalResource>
    + ExistsByCode(code: string): Task<bool>
    + Add(resource: PhysicalResource): Task<PhysicalResource>
    + Update(resource: PhysicalResource, errors: List<string>): Task<PhysicalResource>
    - MapToDomain(dataModel: PhysicalResourceDataModel): PhysicalResource
    - MapToDataModel(resource: PhysicalResource): PhysicalResourceDataModel
  }

  class PhysicalResourceDataModel <<Entity>> {
    + Id: long
    + Code: string
    + Description: string
    + Type: string
    + Capacity: int
    + AssignedArea: string
    + Status: string
    + SetupTimeMinutes: int
    + QualificationRequirementIds: string
    + ChangedAt: DateTime?
    + ChangedBy: string
    + OperationType: string
  }

  class PortLogisticsContext <<Context>> {
    + PhysicalResources: DbSet<PhysicalResourceDataModel>
    + SaveChangesAsync(): Task<int>
  }
}

