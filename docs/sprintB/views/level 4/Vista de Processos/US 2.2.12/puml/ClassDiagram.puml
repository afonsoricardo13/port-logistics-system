skinparam classAttributeIconSize 0

' ===== Presentation Layer (Controllers) =====
package "<<layer>> Presentation" #87CEEB {
  class PhysicalResourceController <<Controller>> {
    - _service: IPhysicalResourceService
    + CreatePhysicalResource(dto: CreatePhysicalResourceDTO): IActionResult
    + UpdatePhysicalResource(code: string, dto: UpdatePhysicalResourceDTO): IActionResult
    + DeactivatePhysicalResource(code: string): IActionResult
    + ReactivatePhysicalResource(code: string): IActionResult
    + GetPhysicalResource(code: string): IActionResult
    + ListPhysicalResources(filters: ResourceFilters): IActionResult
