@startuml Vista de Processos - Level 4 (US 2.2.12 - Deactivate Physical Resource)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
    ArrowColor Black
    ActorBorderColor #000000
    ActorBackgroundColor #87CEEB
    LifeLineBorderColor Black
    LifeLineBackgroundColor #87CEEB
    ParticipantBorderColor Black
    ParticipantBackgroundColor #87CEEB
    ParticipantFontStyle bold
}

actor "Logistics Operator" as LO
participant "<<container (C4)>>\nSPA (Web UI)" as UI_CTRL #87CEEB
participant "<<container (C4)>>\nPort Logistics (Backend)\nController" as MDR_CTRL #87CEEB
participant "<<component>>\nApplication Service" as MDR_APP #87CEEB
participant "<<component>>\nDomain Model (PhysicalResource)" as MDR_DOMAIN #87CEEB
participant "<<component>>\nRepository" as MDR_REPO #87CEEB
participant "<<component>>\nData Model" as MDR_DATA #87CEEB
participant "<<component>>\nPersistence" as MDR_PERSIST #87CEEB

activate LO
LO -> UI_CTRL: 1: PATCH /api/PhysicalResources/{code}?status=inactive
activate UI_CTRL
UI_CTRL -> MDR_CTRL: 1.1: deactivatePhysicalResource(code, changedBy)
activate MDR_CTRL
MDR_CTRL -> MDR_APP: 1.1.1: deactivatePhysicalResource(code, changedBy)
activate MDR_APP

MDR_APP -> MDR_REPO: 1.1.1.1: getByCodeAsync(code)
activate MDR_REPO
MDR_REPO -> MDR_PERSIST: 1.1.1.1.1: fetch resource record
activate MDR_PERSIST
MDR_PERSIST --> MDR_REPO: 1.1.1.1.2: record or null
deactivate MDR_PERSIST
MDR_REPO -> MDR_DATA: 1.1.1.1.3: map to domain
activate MDR_DATA
MDR_DATA --> MDR_REPO: 1.1.1.1.4: resource aggregate or null
deactivate MDR_DATA
MDR_REPO --> MDR_APP: 1.1.1.1.5: resource or null
deactivate MDR_REPO

alt resource not found
  MDR_APP --> MDR_CTRL: 1.1.1.a: NotFoundException\n"Physical resource not found"
  MDR_CTRL --> UI_CTRL: 1.1.a: HTTP 404 Not Found
  UI_CTRL --> LO: 1.1.b: show error
else resource found

  MDR_APP -> MDR_DOMAIN: 1.1.1.2: deactivate(changedBy)
  activate MDR_DOMAIN
  MDR_DOMAIN -> MDR_DOMAIN: check Status
  
  alt status validation failed
    alt already inactive
      MDR_DOMAIN --> MDR_APP: 1.1.1.2.a: BusinessRuleValidationException\n"Resource already inactive"
      MDR_APP --> MDR_CTRL: 1.1.1.c: validation error
      MDR_CTRL --> UI_CTRL: 1.1.d: HTTP 400 Bad Request
      UI_CTRL --> LO: 1.1.e: show error "Already inactive"
    end
  else valid status transition
    MDR_DOMAIN -> MDR_DOMAIN: validate status transition (BR3)\nActive → Inactive allowed\nUnderMaintenance → Inactive allowed
    MDR_DOMAIN -> MDR_DOMAIN: set Status = Inactive\nset ChangedAt = now\nset ChangedBy = operator\nset OperationType = "DEACTIVATE"\npreserve all other data
    MDR_DOMAIN --> MDR_APP: 1.1.1.2.1: deactivated resource
    deactivate MDR_DOMAIN

    MDR_APP -> MDR_REPO: 1.1.1.3: update(resource, errorList)
    activate MDR_REPO
    MDR_REPO -> MDR_DATA: 1.1.1.3.1: map to data model
    activate MDR_DATA
    MDR_DATA --> MDR_REPO: 1.1.1.3.2: updated record
    deactivate MDR_DATA
    MDR_REPO -> MDR_PERSIST: 1.1.1.3.3: UPDATE physical_resources\nSET status = 'Inactive', changedAt = now, changedBy, operationType
    activate MDR_PERSIST
    MDR_PERSIST --> MDR_REPO: 1.1.1.3.4: ok
    deactivate MDR_PERSIST
    MDR_REPO --> MDR_APP: 1.1.1.3.5: persisted(deactivated resource)
    deactivate MDR_REPO

    MDR_APP --> MDR_CTRL: 1.1.2: success (true)
    deactivate MDR_APP
    MDR_CTRL --> UI_CTRL: 1.2: HTTP 200 OK
    deactivate MDR_CTRL
    UI_CTRL --> LO: 1.3: show confirmation\n"Physical resource deactivated (data preserved)"
  end
end

deactivate UI_CTRL
deactivate LO

note right of MDR_DOMAIN
  Deactivation rules:
  - Resource must exist (404 if not)
  - Valid status transition (BR3):
    * Active → Inactive ✓
    * UnderMaintenance → Inactive ✓
    * Inactive → Inactive ✗
  - Set Status = Inactive
  - ALL data preserved (soft delete) (BR2)
  - Audit trail updated (BR7)
  - No physical deletion
end note

note right of MDR_APP
  Service coordination:
  - Fetch existing resource
  - Delegate deactivation to domain
  - Persist status change
  - Return success/failure
  - Historical references preserved
end note

@enduml
