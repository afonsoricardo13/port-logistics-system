' ===== Domain Layer (Aggregates, Entities, Value Objects) =====
package "<<layer>> Domain" #87CEEB {
  class StorageArea <<Aggregate Root>> {
    - _id: long
    - _identifier: string
    - _type: string
    - _location: string
    - _maxCapacityTeu: int
    - _currentOccupancyTeu: int
    - _servedDocks: List<ServedDock>
    + StorageArea(identifier, type, location, maxCapacity, currentOccupancy)
    + Update(type, location, maxCapacity, currentOccupancy): void
    + SetServedDocks(docks: List<ServedDock>): void
    + AddServedDock(dock: ServedDock): void
    + RemoveServedDock(dockCode: string): void
    + ValidateCapacity(): void
    + {static} NormalizeType(type: string): string
  }

  class ServedDock <<Value Object>> {
    + DockCode: string
    + DistanceMeters: double
    + ServedDock(dockCode: string, distance: double)
    + Equals(other: ServedDock): bool
  }

  interface IStorageAreaRepository <<Repository Interface>> {
    + GetAllAsync(): Task<List<StorageArea>>
    + GetByIdentifierAsync(identifier: string): Task<StorageArea>
    + Exists(identifier: string): Task<bool>
    + Add(area: StorageArea): Task<StorageArea>
    + Update(area: StorageArea, errors: List<string>): Task<StorageArea>
  }
}

' ===== Infrastructure Layer (Repositories & Persistence) =====
package "<<layer>> Infrastructure" #87CEEB {
  class StorageAreaRepository <<Repository>> {
    - _context: PortLogisticsContext
    + GetAllAsync(): Task<List<StorageArea>>
    + GetByIdentifierAsync(identifier: string): Task<StorageArea>
    + Exists(identifier: string): Task<bool>
    + Add(area: StorageArea): Task<StorageArea>
    + Update(area: StorageArea, errors: List<string>): Task<StorageArea>
    - MapToDomain(dataModel: StorageAreaDataModel): StorageArea
    - MapToDataModel(area: StorageArea): StorageAreaDataModel
  }

  class StorageAreaDataModel <<Entity>> {
    + Id: long
    + Identifier: string
    + Type: string
    + Location: string
    + MaxCapacityTeu: int
    + CurrentOccupancyTeu: int
    + ServedDocks: List<StorageAreaServedDockDataModel>
  }

  class StorageAreaServedDockDataModel <<Entity>> {
    + Id: long
    + StorageAreaId: long
    + DockCode: string
    + DistanceMeters: double
  }

  class PortLogisticsContext <<Context>> {
    + StorageAreas: DbSet<StorageAreaDataModel>
    + StorageAreaServedDocks: DbSet<StorageAreaServedDockDataModel>
    + SaveChangesAsync(): Task<int>
  }
}

