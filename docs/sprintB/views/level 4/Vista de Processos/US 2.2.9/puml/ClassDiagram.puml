StorageAreaService ..> UpdateStorageAreaDTO : receives
StorageAreaService ..> StorageAreaDTO : returns

CreateStorageAreaDTO *-- ServedDockDTO
UpdateStorageAreaDTO *-- ServedDockDTO
StorageAreaDTO *-- ServedDockDTO

StorageArea *-- "0..*" ServedDock : has

StorageAreaRepository ..|> IStorageAreaRepository : implements
StorageAreaRepository --> PortLogisticsContext : uses
