@startuml Vista de Processos - Level 4 (US 2.2.9 - Get Storage Area Details)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
    ArrowColor Black
    ActorBorderColor #000000
    ActorBackgroundColor #87CEEB
    LifeLineBorderColor Black
    LifeLineBackgroundColor #87CEEB
    ParticipantBorderColor Black
    ParticipantBackgroundColor #87CEEB
    ParticipantFontStyle bold
}

actor "Port Authority Officer" as PAO
participant "<<container (C4)>>\nSPA (Web UI)" as UI_CTRL #87CEEB
participant "<<container (C4)>>\nPort Logistics (Backend)\nController" as MDR_CTRL #87CEEB
participant "<<component>>\nApplication Service" as MDR_APP #87CEEB
participant "<<component>>\nRepository" as MDR_REPO #87CEEB
participant "<<component>>\nData Model" as MDR_DATA #87CEEB
participant "<<component>>\nPersistence" as MDR_PERSIST #87CEEB

activate PAO
PAO -> UI_CTRL: 1: GET /api/storage-areas/{identifier}
activate UI_CTRL
UI_CTRL -> MDR_CTRL: 1.1: getStorageArea(identifier)
activate MDR_CTRL
MDR_CTRL -> MDR_APP: 1.1.1: getStorageArea(identifier)
activate MDR_APP

MDR_APP -> MDR_REPO: 1.1.1.1: getByIdentifierAsync(identifier)
activate MDR_REPO
MDR_REPO -> MDR_PERSIST: 1.1.1.1.1: SELECT * FROM storage_areas\nWHERE identifier = @identifier\nINCLUDE served_docks
activate MDR_PERSIST
MDR_PERSIST --> MDR_REPO: 1.1.1.1.2: area record + served_docks or null
deactivate MDR_PERSIST
MDR_REPO -> MDR_DATA: 1.1.1.1.3: map to domain (area + docks)
activate MDR_DATA
MDR_DATA --> MDR_REPO: 1.1.1.1.4: StorageArea aggregate or null
deactivate MDR_DATA
MDR_REPO --> MDR_APP: 1.1.1.1.5: area or null
deactivate MDR_REPO

alt storage area not found
  MDR_APP --> MDR_CTRL: 1.1.1.a: NotFoundException\n"Storage area not found"
  MDR_CTRL --> UI_CTRL: 1.1.a: HTTP 404 Not Found
  UI_CTRL --> PAO: 1.1.b: show error "Area not found"
else area found
  MDR_APP -> MDR_APP: map StorageArea to StorageAreaDTO\ninclude all servedDocks
  MDR_APP --> MDR_CTRL: 1.1.2: StorageAreaDTO\n{identifier, type, location, capacities, servedDocks[]}
  deactivate MDR_APP
  MDR_CTRL --> UI_CTRL: 1.2: HTTP 200 OK + body
  deactivate MDR_CTRL
  UI_CTRL --> PAO: 1.3: display area details\n- Identifier, Type, Location\n- Max Capacity / Current Occupancy\n- Served Docks (code, distance)
end

deactivate UI_CTRL
deactivate PAO

note right of MDR_REPO
  Repository responsibilities:
  - Fetch area with eager loading
  - Include all served docks
  - Map data model to domain
  - Return null if not found
end note

note right of MDR_APP
  Service responsibilities:
  - Orchestrate retrieval
  - Map domain to DTO
  - Calculate derived data:
    * Occupancy percentage
    * Available capacity
    * Serves all docks flag
end note

@enduml
