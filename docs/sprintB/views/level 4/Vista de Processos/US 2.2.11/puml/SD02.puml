@startuml Vista de Processos - Level 4 (US 2.2.11 - Update Operating Staff)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
    ArrowColor Black
    ActorBorderColor #000000
    ActorBackgroundColor #87CEEB
    LifeLineBorderColor Black
    LifeLineBackgroundColor #87CEEB
    ParticipantBorderColor Black
    ParticipantBackgroundColor #87CEEB
    ParticipantFontStyle bold
}

actor "Logistics Operator" as LO
participant "<<container (C4)>>\nSPA (Web UI)" as UI_CTRL #87CEEB
participant "<<container (C4)>>\nPort Logistics (Backend)\nController" as MDR_CTRL #87CEEB
participant "<<component>>\nApplication Service" as MDR_APP #87CEEB
participant "<<component>>\nDomain Model (OperatingStaff)" as MDR_DOMAIN #87CEEB
participant "<<component>>\nRepository" as MDR_REPO #87CEEB
participant "<<component>>\nData Model" as MDR_DATA #87CEEB
participant "<<component>>\nPersistence" as MDR_PERSIST #87CEEB

activate LO
LO -> UI_CTRL: 1: PUT /api/operatingstaff/{id}\n{name, email, phone, qualifications[]}
activate UI_CTRL
UI_CTRL -> MDR_CTRL: 1.1: updateOperatingStaff(id, dto)
activate MDR_CTRL
MDR_CTRL -> MDR_APP: 1.1.1: updateOperatingStaff(id, dto)
activate MDR_APP

MDR_APP -> MDR_REPO: 1.1.1.1: getById(id)
activate MDR_REPO
MDR_REPO -> MDR_PERSIST: 1.1.1.1.1: fetch staff record
activate MDR_PERSIST
MDR_PERSIST --> MDR_REPO: 1.1.1.1.2: record or null
deactivate MDR_PERSIST
MDR_REPO -> MDR_DATA: 1.1.1.1.3: map to domain
activate MDR_DATA
MDR_DATA --> MDR_REPO: 1.1.1.1.4: staff aggregate or null
deactivate MDR_DATA
MDR_REPO --> MDR_APP: 1.1.1.1.5: staff or null
deactivate MDR_REPO

alt staff not found
  MDR_APP --> MDR_CTRL: 1.1.1.a: NotFoundException\n"Operating staff not found"
  MDR_CTRL --> UI_CTRL: 1.1.a: HTTP 404 Not Found
  UI_CTRL --> LO: 1.1.b: show error
else staff found

  alt email changed
    MDR_APP -> MDR_REPO: 1.1.1.2: existsByEmailExcludingId(dto.email, id)
    activate MDR_REPO
    MDR_REPO -> MDR_PERSIST: 1.1.1.2.1: query email uniqueness
    activate MDR_PERSIST
    MDR_PERSIST --> MDR_REPO: 1.1.1.2.2: exists? (true/false)
    deactivate MDR_PERSIST
    MDR_REPO --> MDR_APP: 1.1.1.2.3: exists
    deactivate MDR_REPO

    alt email already in use
      MDR_APP --> MDR_CTRL: 1.1.1.c: BusinessRuleValidationException\n"Email already registered"
      MDR_CTRL --> UI_CTRL: 1.1.d: HTTP 400 Bad Request
      UI_CTRL --> LO: 1.1.e: show error
    end
  end

  MDR_APP -> MDR_DOMAIN: 1.1.1.3: update(dto)
  activate MDR_DOMAIN
  MDR_DOMAIN -> MDR_DOMAIN: validate name not empty\nvalidate email format\nvalidate phone format\nvalidate qualifications not empty
  
  alt invalid data
    MDR_DOMAIN --> MDR_APP: 1.1.1.3.a: ArgumentException\n"Invalid staff data"
    MDR_APP --> MDR_CTRL: 1.1.1.f: validation error
    MDR_CTRL --> UI_CTRL: 1.1.g: HTTP 400 Bad Request
    UI_CTRL --> LO: 1.1.h: show validation errors
  else valid update
    MDR_DOMAIN -> MDR_DOMAIN: apply changes\nset UpdatedAt = now
    MDR_DOMAIN --> MDR_APP: 1.1.1.3.1: updated staff
    deactivate MDR_DOMAIN

    MDR_APP -> MDR_REPO: 1.1.1.4: save(updated staff)
    activate MDR_REPO
    MDR_REPO -> MDR_DATA: 1.1.1.4.1: map to data model
    activate MDR_DATA
    MDR_DATA --> MDR_REPO: 1.1.1.4.2: updated record
    deactivate MDR_DATA
    MDR_REPO -> MDR_PERSIST: 1.1.1.4.3: UPDATE operating_staff
    activate MDR_PERSIST
    MDR_PERSIST --> MDR_REPO: 1.1.1.4.4: ok
    deactivate MDR_PERSIST
    MDR_REPO --> MDR_APP: 1.1.1.4.5: persisted(updated staff)
    deactivate MDR_REPO

    MDR_APP --> MDR_CTRL: 1.1.2: updated OperatingStaffDTO
    deactivate MDR_APP
    MDR_CTRL --> UI_CTRL: 1.2: HTTP 200 OK {id, name, email, ...}
    deactivate MDR_CTRL
    UI_CTRL --> LO: 1.3: show confirmation\n"Staff member updated successfully"
  end
end

deactivate UI_CTRL
deactivate LO

note right of MDR_DOMAIN
  Update rules:
  - Staff must exist (404 if not)
  - Email unique if changed (BR2)
  - All validations re-applied
  - UpdatedAt timestamp updated
  - IsActive status preserved
end note

note right of MDR_APP
  Service coordination:
  - Fetch existing staff
  - Check email uniqueness if changed
  - Delegate validation to domain
  - Persist changes via repository
end note

@enduml
