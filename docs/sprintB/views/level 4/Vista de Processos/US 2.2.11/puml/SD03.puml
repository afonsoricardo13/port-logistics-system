@startuml Vista de Processos - Level 4 (US 2.2.11 - Deactivate Operating Staff)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
    ArrowColor Black
    ActorBorderColor #000000
    ActorBackgroundColor #87CEEB
    LifeLineBorderColor Black
    LifeLineBackgroundColor #87CEEB
    ParticipantBorderColor Black
    ParticipantBackgroundColor #87CEEB
    ParticipantFontStyle bold
}

actor "Logistics Operator" as LO
participant "<<container (C4)>>\nSPA (Web UI)\nController" as UI_CTRL #87CEEB
participant "<<container (C4)>>\nPort Logistics (Backend)\nController" as MDR_CTRL #87CEEB
participant "<<component>>\nApplication Service" as MDR_APP #87CEEB
participant "<<component>>\nDomain Model (OperatingStaff)" as MDR_DOMAIN #87CEEB
participant "<<component>>\nRepository" as MDR_REPO #87CEEB
participant "<<component>>\nData Model" as MDR_DATA #87CEEB
participant "<<component>>\nPersistence" as MDR_PERSIST #87CEEB

activate LO
LO -> UI_CTRL: 1: PATCH /api/operatingstaff/{id}/deactivate
activate UI_CTRL
UI_CTRL -> MDR_CTRL: 1.1: deactivateOperatingStaff(id)
activate MDR_CTRL
MDR_CTRL -> MDR_APP: 1.1.1: deactivateOperatingStaff(id)
activate MDR_APP

MDR_APP -> MDR_REPO: 1.1.1.1: getById(id)
activate MDR_REPO
MDR_REPO -> MDR_PERSIST: 1.1.1.1.1: fetch staff record
activate MDR_PERSIST
MDR_PERSIST --> MDR_REPO: 1.1.1.1.2: record or null
deactivate MDR_PERSIST
MDR_REPO -> MDR_DATA: 1.1.1.1.3: map to domain
activate MDR_DATA
MDR_DATA --> MDR_REPO: 1.1.1.1.4: staff aggregate or null
deactivate MDR_DATA
MDR_REPO --> MDR_APP: 1.1.1.1.5: staff or null
deactivate MDR_REPO

alt staff not found
  MDR_APP --> MDR_CTRL: 1.1.1.a: NotFoundException\n"Operating staff not found"
  MDR_CTRL --> UI_CTRL: 1.1.a: HTTP 404 Not Found
  UI_CTRL --> LO: 1.1.b: show error
else staff found

  MDR_APP -> MDR_DOMAIN: 1.1.1.2: deactivate()
  activate MDR_DOMAIN
  MDR_DOMAIN -> MDR_DOMAIN: check IsActive == true
  
  alt already inactive
    MDR_DOMAIN --> MDR_APP: 1.1.1.2.a: BusinessRuleValidationException\n"Staff already inactive"
    MDR_APP --> MDR_CTRL: 1.1.1.c: validation error
    MDR_CTRL --> UI_CTRL: 1.1.d: HTTP 400 Bad Request
    UI_CTRL --> LO: 1.1.e: show error "Already inactive"
  else active staff
    MDR_DOMAIN -> MDR_DOMAIN: set IsActive = false\nset DeactivatedAt = now\npreserve all other data
    MDR_DOMAIN --> MDR_APP: 1.1.1.2.1: deactivated staff
    deactivate MDR_DOMAIN

    MDR_APP -> MDR_REPO: 1.1.1.3: save(deactivated staff)
    activate MDR_REPO
    MDR_REPO -> MDR_DATA: 1.1.1.3.1: map to data model
    activate MDR_DATA
    MDR_DATA --> MDR_REPO: 1.1.1.3.2: updated record
    deactivate MDR_DATA
    MDR_REPO -> MDR_PERSIST: 1.1.1.3.3: UPDATE operating_staff\nSET is_active = false, deactivated_at = now
    activate MDR_PERSIST
    MDR_PERSIST --> MDR_REPO: 1.1.1.3.4: ok
    deactivate MDR_PERSIST
    MDR_REPO --> MDR_APP: 1.1.1.3.5: persisted(deactivated staff)
    deactivate MDR_REPO

    MDR_APP --> MDR_CTRL: 1.1.2: OperatingStaffDTO {isActive=false}
    deactivate MDR_APP
    MDR_CTRL --> UI_CTRL: 1.2: HTTP 200 OK {id, isActive=false}
    deactivate MDR_CTRL
    UI_CTRL --> LO: 1.3: show confirmation\n"Staff member deactivated (data preserved)"
  end
end

deactivate UI_CTRL
deactivate LO

note right of MDR_DOMAIN
  Deactivation rules:
  - Staff must exist (404 if not)
  - Must be active (BR5)
  - Set IsActive = false
  - Set DeactivatedAt timestamp
  - ALL data preserved (soft delete)
  - No physical deletion
end note

note right of MDR_APP
  Service coordination:
  - Fetch existing staff
  - Delegate deactivation to domain
  - Persist status change
  - Return updated DTO
end note

@enduml
