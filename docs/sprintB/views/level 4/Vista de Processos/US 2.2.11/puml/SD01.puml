@startuml Vista de Processos - Level 4 (US 2.2.11 - Register Operating Staff)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
    ArrowColor Black
    ActorBorderColor #000000
    ActorBackgroundColor #87CEEB
    LifeLineBorderColor Black
    LifeLineBackgroundColor #87CEEB
    ParticipantBorderColor Black
    ParticipantBackgroundColor #87CEEB
    ParticipantFontStyle bold
}

actor "Logistics Operator" as LO
participant "<<container (C4)>>\nSPA (Web UI)" as UI_CTRL #87CEEB
participant "<<container (C4)>>\nPort Logistics (Backend)\nController" as MDR_CTRL #87CEEB
participant "<<component>>\nApplication Service" as MDR_APP #87CEEB
participant "<<component>>\nDomain Model (OperatingStaff)" as MDR_DOMAIN #87CEEB
participant "<<component>>\nRepository" as MDR_REPO #87CEEB
participant "<<component>>\nData Model" as MDR_DATA #87CEEB
participant "<<component>>\nPersistence" as MDR_PERSIST #87CEEB

activate LO
LO -> UI_CTRL: 1: POST /api/operatingstaff\n{name, email, phone, qualifications[]}
activate UI_CTRL
UI_CTRL -> MDR_CTRL: 1.1: createOperatingStaff(dto)
activate MDR_CTRL
MDR_CTRL -> MDR_APP: 1.1.1: createOperatingStaff(dto)
activate MDR_APP

MDR_APP -> MDR_REPO: 1.1.1.1: existsByEmail(dto.email)
activate MDR_REPO
MDR_REPO -> MDR_PERSIST: 1.1.1.1.1: query email uniqueness
activate MDR_PERSIST
MDR_PERSIST --> MDR_REPO: 1.1.1.1.2: exists? (true/false)
deactivate MDR_PERSIST
MDR_REPO --> MDR_APP: 1.1.1.1.3: exists
deactivate MDR_REPO

alt email already registered
  MDR_APP --> MDR_CTRL: 1.1.1.a: BusinessRuleValidationException\n"Email already registered"
  MDR_CTRL --> UI_CTRL: 1.1.a: HTTP 400 Bad Request
  UI_CTRL --> LO: 1.1.b: show error "Email already in use"
else new email

  MDR_APP -> MDR_DOMAIN: 1.1.1.2: build OperatingStaff aggregate (dto)
  activate MDR_DOMAIN
  MDR_DOMAIN -> MDR_DOMAIN: validate name not empty\nvalidate email format\nvalidate phone format\nvalidate qualifications not empty
  
  alt invalid data
    MDR_DOMAIN --> MDR_APP: 1.1.1.2.a: ArgumentException\n"Invalid staff data"
    MDR_APP --> MDR_CTRL: 1.1.1.b: validation error
    MDR_CTRL --> UI_CTRL: 1.1.c: HTTP 400 Bad Request
    UI_CTRL --> LO: 1.1.d: show validation errors
  else valid aggregate
    MDR_DOMAIN -> MDR_DOMAIN: generate StaffId\nset IsActive = true\nset CreatedAt = now
    MDR_DOMAIN --> MDR_APP: 1.1.1.2.1: OperatingStaff aggregate
    deactivate MDR_DOMAIN

    MDR_APP -> MDR_REPO: 1.1.1.3: save(staff)
    activate MDR_REPO
    MDR_REPO -> MDR_DATA: 1.1.1.3.1: map to data model
    activate MDR_DATA
    MDR_DATA --> MDR_REPO: 1.1.1.3.2: staff record
    deactivate MDR_DATA
    MDR_REPO -> MDR_PERSIST: 1.1.1.3.3: INSERT operating_staff
    activate MDR_PERSIST
    MDR_PERSIST --> MDR_REPO: 1.1.1.3.4: persisted record
    deactivate MDR_PERSIST
    MDR_REPO --> MDR_APP: 1.1.1.3.5: persisted(staff)
    deactivate MDR_REPO

    MDR_APP --> MDR_CTRL: 1.1.2: created OperatingStaffDTO
    deactivate MDR_APP
    MDR_CTRL --> UI_CTRL: 1.2: HTTP 201 Created\n(Location: /api/operatingstaff/{id} + body)
    deactivate MDR_CTRL
    UI_CTRL --> LO: 1.3: show confirmation\n"Staff member registered successfully"
  end
end

deactivate UI_CTRL
deactivate LO

note right of MDR_DOMAIN
  Business Rules enforced:
  - Name required (BR1)
  - Email unique & valid format (BR2)
  - Phone valid format (BR3)
  - At least one qualification required (BR4)
  - IsActive = true by default
  - StaffId auto-generated
end note

note right of MDR_APP
  Service coordination:
  - Check email uniqueness
  - Delegate validation to domain
  - Persist via repository
  - Return DTO or errors
end note

@enduml
