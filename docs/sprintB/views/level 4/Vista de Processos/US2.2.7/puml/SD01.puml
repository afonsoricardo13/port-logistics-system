@startuml Vista de Processos - Level 4 (US 2.2.7 - Approve Visit)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
    ArrowColor Black
    ActorBorderColor #000000
    ActorBackgroundColor #87CEEB
    LifeLineBorderColor Black
    LifeLineBackgroundColor #87CEEB
    ParticipantBorderColor Black
    ParticipantBackgroundColor #87CEEB
    ParticipantFontStyle bold
}

actor "Port Authority Officer" as Officer
participant "<<container (C4)>>\nVisualization (UI)\nController" as UI_CTRL #87CEEB
participant "<<container (C4)>>\nVisits & Manifests\nController" as MDR_CTRL #87CEEB
participant "<<component>>\nApplication Service" as MDR_APP #87CEEB
participant "<<component>>\nDomain Model (VesselVisitNotification)" as MDR_DOMAIN #87CEEB
participant "<<component>>\nDock Repository" as DOCK_REPO #87CEEB
participant "<<component>>\nRepository" as MDR_REPO #87CEEB
participant "<<component>>\nData Model" as MDR_DATA #87CEEB
participant "<<component>>\nPersistence" as MDR_PERSIST #87CEEB

activate Officer
Officer -> UI_CTRL: 1: PATCH /api/vessel-visits/notifications/{id}/decision?officerId={officer}\n{Status=Approved, AssignedDockCode}
activate UI_CTRL
UI_CTRL -> MDR_CTRL: 1.1: updateDecision(id, dto, officerId)
activate MDR_CTRL
MDR_CTRL -> MDR_APP: 1.1.1: approve(id, officerId, dto, errors)
activate MDR_APP

MDR_APP -> MDR_REPO: 1.1.1.1: getById(id)
activate MDR_REPO
MDR_REPO -> MDR_PERSIST: 1.1.1.1.1: fetch notification
activate MDR_PERSIST
MDR_PERSIST --> MDR_REPO: 1.1.1.1.2: record or null
deactivate MDR_PERSIST
MDR_REPO -> MDR_DATA: 1.1.1.1.3: map to domain
activate MDR_DATA
MDR_DATA --> MDR_REPO: 1.1.1.1.4: vvn aggregate or null
deactivate MDR_DATA
MDR_REPO --> MDR_APP: 1.1.1.1.5: vvn or null
deactivate MDR_REPO

alt notification not found
  MDR_APP --> MDR_CTRL: 1.1.1.a: null, errors = ["Vessel Visit Notification not found"]
  MDR_CTRL --> UI_CTRL: 1.1.a: HTTP 400 Bad Request
  UI_CTRL --> Officer: 1.1.b: show error
else notification found

  MDR_APP -> DOCK_REPO: 1.1.1.2: validate dock exists(dto.AssignedDockCode)
  activate DOCK_REPO
  DOCK_REPO -> MDR_PERSIST: 1.1.1.2.1: fetch dock by code
  activate MDR_PERSIST
  MDR_PERSIST --> DOCK_REPO: 1.1.1.2.2: dock or null
  deactivate MDR_PERSIST
  DOCK_REPO --> MDR_APP: 1.1.1.2.3: exists? (bool)
  deactivate DOCK_REPO

  alt dock not found
    MDR_APP --> MDR_CTRL: 1.1.1.b: null, errors = ["Assigned dock does not exist"]
    MDR_CTRL --> UI_CTRL: 1.1.c: HTTP 400 Bad Request
    UI_CTRL --> Officer: 1.1.d: show error
  else dock ok

    MDR_APP -> MDR_DOMAIN: 1.1.1.3: approve(officerId, dockCode, errors)
    activate MDR_DOMAIN
    MDR_DOMAIN -> MDR_DOMAIN: validate status == Submitted\nvalidate officerId & dockCode
    alt invalid status/args
      MDR_DOMAIN --> MDR_APP: 1.1.1.3.a: errors
    else ok
      MDR_DOMAIN -> MDR_DOMAIN: set AssignedDockCode; add DecisionLog; Status = Approved
      MDR_DOMAIN --> MDR_APP: 1.1.1.3.1: approved vvn
    end
    deactivate MDR_DOMAIN

    alt errors collected
      MDR_APP --> MDR_CTRL: 1.1.1.d: null, errors
      MDR_CTRL --> UI_CTRL: 1.1.e: HTTP 400 Bad Request
      UI_CTRL --> Officer: 1.1.f: show error
    else approved

      MDR_APP -> MDR_REPO: 1.1.1.4: update(vvn, errors)
      activate MDR_REPO
      MDR_REPO -> MDR_DATA: 1.1.1.4.1: map to data model
      activate MDR_DATA
      MDR_DATA --> MDR_REPO: 1.1.1.4.2: updated record
      deactivate MDR_DATA
      MDR_REPO -> MDR_PERSIST: 1.1.1.4.3: UPDATE vessel visit notification
      activate MDR_PERSIST
      MDR_PERSIST --> MDR_REPO: 1.1.1.4.4: ok
      deactivate MDR_PERSIST
      MDR_REPO --> MDR_APP: 1.1.1.4.5: persisted(approved vvn)
      deactivate MDR_REPO

      MDR_APP --> MDR_CTRL: 1.1.2: VesselVisitNotificationDTO
      deactivate MDR_APP
      MDR_CTRL --> UI_CTRL: 1.2: HTTP 200 OK {id, status=Approved, assignedDockCode}
      deactivate MDR_CTRL
      UI_CTRL --> Officer: 1.3: show approval
    end
  end
end

deactivate UI_CTRL
deactivate Officer

note right of MDR_DOMAIN
  Approval rules:
  - Only Submitted -> Approved
  - OfficerId and DockCode required
  - AssignedDockCode stored
  - DecisionLog appended (Approved)
end note

note right of MDR_APP
  Service coordination:
  - Fetch VVN by Id
  - Validate dock existence
  - Delegate approval to domain
  - Persist via repository; return DTO/errors
end note

@enduml
