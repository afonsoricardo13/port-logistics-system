package "Domain Layer" {
    enum VvnStatus {
        InProgress = 0
        Submitted = 1
        Approved = 2
        Rejected = 3
    }

    class VesselVisitNotification <<Entity>> {
        + Id: long
        - _vesselImoNumber: string
        - _containerIds: List<string>
        - _crew: List<CrewMember>
        - _decisionLogs: List<DecisionLog>
        + VesselImoNumber: string {get}
        + EstimatedTimeOfArrival: DateTime? {get; private set}
        + EstimatedTimeOfDeparture: DateTime? {get; private set}
        + ContainerIds: IReadOnlyCollection<string> {get}
        + Crew: IReadOnlyCollection<CrewMember> {get}
        + Status: VvnStatus {get; private set}
        + AssignedDockCode: string? {get; private set}
        + SubmittedByRepresentativeId: long? {get; private set}
        + TotalUnloadingContainers: int {get; private set}
        + LoadingContainerCount: int {get; private set}
        + DecisionLogs: IReadOnlyCollection<DecisionLog> {get}
        + VesselVisitNotification(vesselImoNumber, eta, etd, containerIds, crew, representativeId)
        + AddOrReplaceCargoManifest(containerIds: IEnumerable<string>): void
        + AddOrReplaceCrew(crew: IEnumerable<CrewMember>): void
        + UpdateDetails(eta: DateTime?, etd: DateTime?, errors: List<string>): void
        + Submit(errors: List<string>): void
        + Approve(officerId: string, assignedDockCode: string, errors: List<string>): void
        + Reject(officerId: string, reason: string, errors: List<string>): void
    }

    class CrewMember <<Entity>> {
        + Id: long
        + Name: string {get; private set}
        + CitizenId: string {get; private set}
        + Nationality: string {get; private set}
        + CrewMember(name, citizenId, nationality)
    }

    class Iso6346 <<Utility>> {
        + {static} IsValid(code: string): bool
        - {static} CharValue(c: char): int
    }

    interface IVesselVisitNotificationRepository <<Repository>> {
        + GetByIdAsync(id: long): Task<VesselVisitNotification?>
        + Add(vvn: VesselVisitNotification): Task<VesselVisitNotification>
        + Update(vvn: VesselVisitNotification, errorMessages: List<string>): Task<VesselVisitNotification?>
        + GetByStatusAsync(status: VvnStatus): Task<IEnumerable<VesselVisitNotification>>
        + GetFilteredAsync(vesselImoNumber?, status?, dateFrom?, dateTo?, representativeId?, organizationId?): Task<IEnumerable<VesselVisitNotification>>
        + GetByRepresentativeIdAsync(representativeId: long): Task<IEnumerable<VesselVisitNotification>>
        + GetByOrganizationIdAsync(organizationId: long): Task<IEnumerable<VesselVisitNotification>>
        + UpdateAdditionalFields(vvnId: long, captainName?, crewCount?, safetyOfficers?, preferredDockCode?, unloadingManifest?, loadingManifest?): Task
        + GetAdditionalFieldsAsync(id: long): Task<(...)>
        + Delete(id: long): Task<bool>
    }
}

