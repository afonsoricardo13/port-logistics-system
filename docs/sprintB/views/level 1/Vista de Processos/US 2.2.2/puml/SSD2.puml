@startuml SSD US 2.2.2 - Update Vessel
skinparam shadowing true
skinparam ArrowColor #000000
skinparam sequence {
  ActorBorderColor #000000
  ActorBackgroundColor #87CEEB
  ParticipantBorderColor #000000
  ParticipantBackgroundColor #87CEEB
  LifeLineBorderColor #000000
  LifeLineBackgroundColor #87CEEB
}

actor "Port Authority Officer" as Officer
participant "«system (C4)»\nPort Operations System" as System

activate Officer
Officer -> System : 1: selects vessel to update
activate System
System  --> Officer : 1.1: show current vessel data
deactivate System
Officer -> System : 2: submit changes\n(IMO, name, type, operator/owner)
activate System
System  --> Officer : 2.1: vessel updated successfully
deactivate System
deactivate Officer

@enduml
