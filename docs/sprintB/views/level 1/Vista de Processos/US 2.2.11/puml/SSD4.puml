@startuml SSD US 2.2.11 - Reactivate Operating Staff
skinparam shadowing true
skinparam ArrowColor #000000
skinparam sequence {
	ArrowColor Black
  ActorBorderColor #000000
  ActorBackgroundColor #87CEEB
	LifeLineBorderColor Black
	LifeLineBackgroundColor #87CEEB
	ParticipantBorderColor Black
	ParticipantBackgroundColor #87CEEB
	ParticipantFontStyle bold
}

actor "Logistics Operator" as Operator
participant "«system (C4)»\nPort Operations System" as System

activate Operator
Operator -> System : 1: selects staff member to reactivate
activate System
System  --> Operator : 1.1: request confirmation
Operator -> System : 2: confirm reactivation
System  --> Operator : 2.1: staff member reactivated (data preserved)
deactivate System
deactivate Operator

@enduml
