@startuml Vista de Processos – Level 2 (US 2.2.2 – Register Vessel)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
	ArrowColor Black
  ActorBorderColor #000000
  ActorBackgroundColor #87CEEB
	LifeLineBorderColor Black
	LifeLineBackgroundColor #87CEEB
	ParticipantBorderColor Black
	ParticipantBackgroundColor #87CEEB
	ParticipantFontStyle bold
}

actor "Port Authority Officer" as PA
participant "<<container (C4)>>\nVisualization (UI)" as UI #87CEEB
participant "<<container (C4)>>\nVisits & Manifests" as VEM #87CEEB

activate PA
PA -> UI: 1: register vessel
activate UI
UI --> PA: 1.1: ask for vessel data
deactivate UI
PA -> UI: 2: dock vessel
activate UI
UI --> VEM: 2.1: request to register vessel
activate VEM
VEM -> UI: 2.2: vessel registered
deactivate VEM
UI --> PA: 2.3: vessel registered
deactivate UI
deactivate PA

@enduml
