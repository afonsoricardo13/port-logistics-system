@startuml Vista de Processos – Level 2 (US 2.2.7 – Approve Vessel Visit Notification)
skinparam shadowing true
skinparam linetype ortho
skinparam sequence {
    ArrowColor Black
    ActorBorderColor #000000
    ActorBackgroundColor #87CEEB
    LifeLineBorderColor Black
    LifeLineBackgroundColor #87CEEB
    ParticipantBorderColor Black
    ParticipantBackgroundColor #87CEEB
    ParticipantFontStyle bold
}

actor "Port Authority Officer" as Officer
participant "<<container (C4)>>\nVisualization (UI)" as UI #87CEEB
participant "<<container (C4)>>\nVisits & Manifests" as VVN #87CEEB
participant "<<container (C4)>>\nDocks & Resources" as DOCK #87CEEB

activate Officer
Officer -> UI: 1: select notification to approve
activate UI
UI --> Officer: 1.1: show notification details
deactivate UI

Officer -> UI: 2: approve notification
activate UI
UI -> DOCK: 2.1: get compatible docks
activate DOCK
DOCK --> UI: 2.2: list of available docks
deactivate DOCK
UI --> Officer: 2.3: request dock assignment
deactivate UI

Officer -> UI: 3: assign dock (dock code) and confirm
activate UI
UI -> VVN: 3.1: approve notification (notificationId, dockCode, officerId)
activate VVN
VVN --> UI: 3.2: approval confirmation
deactivate VVN
UI --> Officer: 3.3: notification approved successfully
deactivate UI
deactivate Officer

@enduml
