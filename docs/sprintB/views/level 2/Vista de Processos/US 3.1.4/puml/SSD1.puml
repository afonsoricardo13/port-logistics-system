@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

actor "System User" as User
participant "Frontend" as UI
participant "Backend" as Backend
participant "Database" as DB

activate User
User -> UI : complete action

activate UI
UI -> Backend : send request to process action

activate Backend
Backend -> DB : query/update data as needed

activate DB
DB --> Backend : return result of query/update
deactivate DB

Backend --> UI : return result of action
deactivate Backend

UI --> User : retrieve clear feedback on action success or failure
deactivate UI

deactivate User

@enduml