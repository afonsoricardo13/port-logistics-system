@startuml Vista de Processos – Level 2 (US 2.2.6 – Create Representative)
		    		   skinparam shadowing true
		    		   skinparam linetype ortho
		    		   skinparam sequence {
		    		    ArrowColor Black
		    		    ActorBorderColor #000000
		    		    ActorBackgroundColor #87CEEB
		    		    LifeLineBorderColor Black
		    		    LifeLineBackgroundColor #87CEEB
		    		    ParticipantBorderColor Black
		    		    ParticipantBackgroundColor #87CEEB
		    		    ParticipantFontStyle bold
		    		   }
		    		   
		    		   actor "Port Authority Officer" as PA
		    		   participant "<<container (C4)>>\nVisualization (UI)" as UI #87CEEB
		    		   participant "<<container (C4)>>\nPlanning & Scheduling" as PLAN #87CEEB
		    		   
		    		   activate PA
		    		   PA -> UI: 1: create representative
		    		   activate UI
		    		   UI --> PA: 1.1: ask for representative data\n(name, citizenId, nationality, email, phone, orgIdentifier)
		    
		    		   deactivate UI
		    		   
		    		   PA -> UI: 2: representative data + org identifier
		    		   activate UI
		    		   UI --> PLAN: 2.1: request to create representative
		    		   activate PLAN
		    		   PLAN -> PLAN: 2.2: verify organization exists\nvalidate required fields\nvalidate email/phone formats\nensure association to exactly one org\npersist representative (active = true)\nrecord audit
		    		   PLAN --> UI: 2.3: representative created (201 Created + Location)
		    		   deactivate PLAN
		    		   UI --> PA: 2.4: representative created
		    		   deactivate UI
		    		   deactivate PA
		    		   
		    		   @enduml